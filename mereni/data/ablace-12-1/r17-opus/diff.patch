--- a/src/Legacy/Admin/OrderController.php
+++ b/src/Legacy/Admin/OrderController.php
@@ -157,4 +157,55 @@ class OrderController extends BaseController
 
         return $this->detailAction();
     }
+
+    /**
+     * Storno z detailu objednavky (2026).
+     *
+     * Stornuje novy e-shop (CancelOrder): ten hlida, ze odeslanou ani dorucenou
+     * objednavku storno nevrati, a rezervace ve skladu uvolni Inventory.
+     * U zaplacene zaznamena castku k vraceni, penize vraci obchod rucne.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+        if (is_post()) {
+            csrf_check();
+        }
+
+        $id = get_param('id');
+        $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+        if (!is_post()) {
+            return $this->redirect(admin_url('order', array('id' => $id)));
+        }
+
+        try {
+            legacy_command(new \App\Ordering\Application\Command\CancelOrder(
+                \App\Ordering\Domain\ValueObject\OrderId::fromString($id),
+                trim((string) $this->post('reason'))
+            ));
+        } catch (\App\Ordering\Domain\Exception\InvalidOrderStateTransitionException $e) {
+            flash('Odeslanou ani doručenou objednávku stornovat nejde', 'error');
+
+            return $this->detailAction();
+        }
+
+        $cancelled = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        audit_log('order', $id, 'storno', array(
+            'from'   => $order['status'],
+            'refund' => (int) $cancelled['refund_amount_in_cents'],
+        ));
+        if ((int) $cancelled['refund_amount_in_cents'] > 0) {
+            flash('Objednávka stornována, vraťte zákazníkovi '
+                . format_price($cancelled['refund_amount_in_cents'], $cancelled['refund_currency']));
+        } else {
+            flash('Objednávka stornována');
+        }
+
+        return $this->detailAction();
+    }
 }
