     protected $title = 'Objednávky';
@@ -153,4 +155,36 @@ class OrderController extends BaseController
 
         return $this->detailAction();
     }
+
+    /**
+     * Uvolneni rezervaci objednavky primo ve skladu (2026).
+     *
+     * Kdyz zakaznik zbozi nevyzvedne, obsluha rezervace uvolni z detailu
+     * objednavky. Objednavka zustava, jak je.
+     */
+    public function releaseStockAction()
+    {
+        $id = get_param('id');
+        if (!is_post()) {
+            return $this->redirect(admin_url('order', array('id' => $id)));
+        }
+
+        $orderId = \App\Ordering\Domain\ValueObject\OrderId::fromString($id);
+        $released = $this->releaseReservations($GLOBALS['LEGACY_STOCK_ITEMS'], $orderId);
+        flash('Uvolněno rezervací: ' . $released);
+
+        return $this->detailAction();
+    }
+
+    private function releaseReservations(StockItemRepository $stockItems, $orderId)
+    {
+        $released = 0;
+        foreach ($stockItems->reservedFor($orderId) as $item) {
+            $item->release($orderId);
+            $stockItems->save($item);
+            $released++;
+        }
+
+        return $released;
+    }
 }
