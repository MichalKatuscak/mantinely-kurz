parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method release\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Inventory/Application/EventHandler/ReleaseReservationsHandler.php

		-
			message: '#^Parameter \#1 \$stockItem of method App\\Inventory\\Domain\\Repository\\StockItemRepository\:\:save\(\) expects App\\Inventory\\Domain\\Model\\StockItem, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Inventory/Application/EventHandler/ReleaseReservationsHandler.php

		-
			message: '#^Cannot access offset ''productId'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Inventory/Application/EventHandler/ReserveStockHandler.php

		-
			message: '#^Cannot access offset ''quantity'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Inventory/Application/EventHandler/ReserveStockHandler.php

		-
			message: '#^Method App\\Inventory\\Application\\EventHandler\\ReserveStockHandler\:\:reserveLines\(\) has parameter \$lines with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Inventory/Application/EventHandler/ReserveStockHandler.php

		-
			message: '#^Parameter \#1 \$value of static method App\\Ordering\\Domain\\ValueObject\\ProductId\:\:fromString\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Inventory/Application/EventHandler/ReserveStockHandler.php

		-
			message: '#^Parameter \#2 \$quantity of method App\\Inventory\\Domain\\Model\\StockItem\:\:reserve\(\) expects int, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Inventory/Application/EventHandler/ReserveStockHandler.php

		-
			message: '#^Binary operation "\+" between mixed and int\<1, max\> results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/Inventory/Domain/Model/StockItem.php

		-
			message: '#^Method App\\Inventory\\Domain\\Model\\StockItem\:\:reservations\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Inventory/Domain/Model/StockItem.php

		-
			message: '#^Property App\\Inventory\\Domain\\Model\\StockItem\:\:\$reservations type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Inventory/Domain/Model/StockItem.php

		-
			message: '#^Method App\\Inventory\\Domain\\Repository\\StockItemRepository\:\:reservedFor\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Inventory/Domain/Repository/StockItemRepository.php

		-
			message: '#^Method App\\Inventory\\Infrastructure\\Repository\\DoctrineStockItemRepository\:\:reservedFor\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Inventory/Infrastructure/Repository/DoctrineStockItemRepository.php
