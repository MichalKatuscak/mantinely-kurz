diff --git a/src/Legacy/lib/functions.php b/src/Legacy/lib/functions.php
index 86c57cb..b1079b9 100644
--- a/src/Legacy/lib/functions.php
+++ b/src/Legacy/lib/functions.php
@@ -187,3 +187,45 @@ function ids_to_sql($ids)
 
     return implode(',', $out);
 }
+
+/**
+ * Stornování objednávky – vrácení zboží na sklad a záznam o vrácení.
+ * Vrací částku k vrácení (v haléřích), nebo false pokud se nepovedlo stornovat.
+ */
+function cancel_order($orderId, $reason = '')
+{
+    global $db;
+    legacy_db();
+
+    $order = $db->one("SELECT * FROM orders WHERE id = '" . $orderId . "'");
+    if ($order === null) {
+        return false;
+    }
+
+    // lze stornovat cokoliv mimo doručených
+    if ($order['status'] === 'delivered') {
+        return false;
+    }
+
+    // vrátit zboží na sklad – odstranit rezervaci z JSON
+    $items = $db->query("SELECT product_id, quantity FROM order_items WHERE order_id = '" . $orderId . "'");
+    foreach ($items as $item) {
+        $stock = $db->one("SELECT reservations FROM stock_items WHERE product_id = '" . $item['product_id'] . "'");
+        if ($stock !== null) {
+            $reservations = json_decode((string) $stock['reservations'], true);
+            if (is_array($reservations) && isset($reservations[$orderId])) {
+                unset($reservations[$orderId]);
+                $db->exec("UPDATE stock_items SET reservations = " . $db->quote(json_encode($reservations)) . " WHERE product_id = '" . $item['product_id'] . "'");
+            }
+        }
+    }
+
+    // změnit stav na stornovanou
+    $db->exec("UPDATE orders SET status = 'cancelled' WHERE id = '" . $orderId . "'");
+
+    // zaznamenat do logu
+    $refund = order_total_after_discount($orderId);
+    audit_log('order', $orderId, 'cancel', array('refund_cents' => $refund, 'reason' => $reason));
+
+    return $refund;
+}
