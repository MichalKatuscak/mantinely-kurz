@@ -0,0 +1,43 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Application\EventHandler;
+
+use App\Ordering\Domain\Event\OrderCancelled;
+use App\Ordering\Domain\Model\Refund;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\Repository\RefundRepository;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+/**
+ * Stornovaná objednávka zaznamenává vrácení peněz.
+ */
+#[AsMessageHandler(bus: 'event.bus')]
+final readonly class RecordRefundHandler
+{
+    public function __construct(
+        private OrderRepository $orders,
+        private RefundRepository $refunds,
+    ) {}
+
+    public function __invoke(OrderCancelled $event): void
+    {
+        $order = $this->orders->find($event->orderId);
+        if ($order === null) {
+            return;
+        }
+
+        $refundAmount = $order->paidAmount();
+        if ($refundAmount->amountInCents > 0) {
+            $refund = new Refund(
+                orderId: $event->orderId,
+                amountInCents: $refundAmount->amountInCents,
+                currency: $refundAmount->currency,
+                reason: $event->reason === '' ? null : $event->reason,
+                createdAt: $event->occurredAt,
+            );
+            $this->refunds->save($refund);
+        }
+    }
+}
diff --git a/src/Ordering/Application/Handler/CancelOrderHandler.php b/src/Ordering/Application/Handler/CancelOrderHandler.php
