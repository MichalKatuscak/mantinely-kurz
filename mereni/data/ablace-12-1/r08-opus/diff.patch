+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená, kolik má obchod zákazníkovi vrátit.
+ * Peníze vrací obchod ručně, platební bránu aplikace nemá.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function newOrderHasNothingToRefund(): void
+    {
+        $order = $this->orderWithItems(Currency::EUR);
+
+        self::assertTrue($order->refundDue->equals(Money::zero(Currency::EUR)));
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRecordsPaidAmountAsRefund(): void
+    {
+        $order = $this->orderWithItems(Currency::EUR);
+        $order->applyDiscount(new Money(100_00, Currency::EUR));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('zákazník si to rozmyslel', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundDue->equals(new Money(500_00, Currency::EUR)));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderHasNothingToRefund(): void
+    {
+        $draft = $this->orderWithItems(Currency::CZK);
+        $confirmed = $this->orderWithItems(Currency::CZK);
+        $confirmed->confirm();
+
+        $draft->cancel('', new \DateTimeImmutable());
+        $confirmed->cancel('', new \DateTimeImmutable());
+
+        self::assertTrue($draft->refundDue->equals(Money::zero(Currency::CZK)));
+        self::assertTrue($confirmed->refundDue->equals(Money::zero(Currency::CZK)));
+    }
+
+    #[Test]
+    public function repeatedCancelKeepsRecordedRefund(): void
+    {
+        $order = $this->orderWithItems(Currency::CZK);
+        $order->confirm();
+        $order->markPaid();
+        $order->cancel('', new \DateTimeImmutable());
+
+        $order->cancel('', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundDue->equals(new Money(600_00, Currency::CZK)));
+    }
+
+    private function orderWithItems(Currency $currency): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), $currency);
+        $order->addItem(ProductId::generate(), 2, new Money(300_00, $currency));
+
+        return $order;
+    }
+}
