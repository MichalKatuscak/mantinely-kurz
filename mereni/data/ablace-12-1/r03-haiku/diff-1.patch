+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Infrastructure\Repository;
+
+use App\Ordering\Domain\Model\Refund;
+use App\Ordering\Domain\Repository\RefundRepository;
+use App\Ordering\Domain\ValueObject\OrderId;
+use Doctrine\ORM\EntityManagerInterface;
+use Symfony\Component\DependencyInjection\Attribute\Autowire;
+
+final readonly class DoctrineRefundRepository implements RefundRepository
+{
+    public function __construct(
+        #[Autowire(service: 'doctrine.orm.default_entity_manager')]
+        private EntityManagerInterface $em,
+    ) {}
+
+    public function save(Refund $refund): void
+    {
+        $this->em->persist($refund);
+        $this->em->flush();
+    }
+
+    public function findByOrder(OrderId $orderId): array
+    {
+        return $this->em->getRepository(Refund::class)
+            ->findBy(['orderId' => $orderId]);
+    }
+}
