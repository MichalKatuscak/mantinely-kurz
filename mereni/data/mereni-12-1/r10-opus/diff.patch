+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Event\OrderCancelled;
+use App\Ordering\Domain\Event\OrderRefundRecorded;
+use App\Ordering\Domain\Exception\InvalidOrderStateTransitionException;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+#[CoversClass(Order::class)]
+#[CoversClass(OrderRefundRecorded::class)]
+final class OrderCancelAndRefundTest extends TestCase
+{
+    #[Test]
+    public function paidOrderRecordsRefundOfPaidAmount(): void
+    {
+        // 2 × 300 € se slevou 100 €: zákazník zaplatil 500 €
+        $order = $this->paidOrder(Currency::EUR);
+        $order->releaseEvents();
+        $when = new \DateTimeImmutable('2026-10-08 10:00');
+
+        $order->cancelAndRefund('Zákazník si to rozmyslel', $when);
+
+        self::assertSame(OrderStatus::Cancelled, $order->status);
+        self::assertSame('Zákazník si to rozmyslel', $order->cancellationNote);
+        self::assertEquals(new Money(500_00, Currency::EUR), $order->refund);
+
+        $events = $order->releaseEvents();
+        self::assertCount(2, $events);
+        self::assertInstanceOf(OrderCancelled::class, $events[0]);
+        self::assertInstanceOf(OrderRefundRecorded::class, $events[1]);
+        self::assertTrue($events[1]->orderId->equals($order->id));
+        self::assertTrue($events[1]->customerId->equals($order->customerId));
+        self::assertEquals(new Money(500_00, Currency::EUR), $events[1]->amount);
+        self::assertSame($when, $events[1]->occurredAt);
+    }
+
+    #[Test]
+    public function unpaidOrderIsCancelledWithoutRefund(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->releaseEvents();
+
+        $order->cancelAndRefund('', new \DateTimeImmutable());
+
+        self::assertSame(OrderStatus::Cancelled, $order->status);
+        self::assertNull($order->refund);
+        $events = $order->releaseEvents();
+        self::assertCount(1, $events);
+        self::assertInstanceOf(OrderCancelled::class, $events[0]);
+    }
+
+    #[Test]
+    public function orderWithoutCancellationHasNoRefund(): void
+    {
+        self::assertNull($this->paidOrder()->refund);
+    }
+
+    #[Test]
+    public function repeatedCancellationRecordsNoSecondRefund(): void
+    {
+        $order = $this->paidOrder();
+        $order->cancelAndRefund('', new \DateTimeImmutable());
+        $order->releaseEvents();
+
+        $order->cancelAndRefund('', new \DateTimeImmutable());
+
+        self::assertSame([], $order->releaseEvents());
+        self::assertEquals(new Money(500_00, Currency::CZK), $order->refund);
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelledNorRefunded(): void
+    {
+        $order = $this->paidOrder();
+        $order->ship();
+        $order->releaseEvents();
+
+        try {
+            $order->cancelAndRefund('', new \DateTimeImmutable());
+            self::fail('Expected InvalidOrderStateTransitionException');
+        } catch (InvalidOrderStateTransitionException) {
+        }
+
+        self::assertSame(OrderStatus::Shipped, $order->status);
+        self::assertNull($order->refund);
+        self::assertSame([], $order->releaseEvents());
+    }
+
+    private function confirmedOrder(Currency $currency = Currency::CZK): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), $currency);
+        $order->addItem(ProductId::generate(), 2, new Money(300_00, $currency));
+        $order->applyDiscount(new Money(100_00, $currency));
+        $order->confirm();
+
+        return $order;
+    }
+
+    private function paidOrder(Currency $currency = Currency::CZK): Order
+    {
+        $order = $this->confirmedOrder($currency);
+        $order->markPaid();
+
+        return $order;
+    }
+}
