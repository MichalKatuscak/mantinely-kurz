+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená částku k vrácení zákazníkovi.
+ * Peníze vrací obchod ručně, platební bránu aplikace nemá.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function cancelledPaidOrderRecordsPaidAmountAsRefundDue(): void
+    {
+        // 2 × 300 Kč, sleva 100 Kč: zákazník zaplatil 500 Kč
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertEquals(new Money(500_00, Currency::CZK), $order->refundDue());
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderHasNoRefundDue(): void
+    {
+        $draft = Order::place(OrderId::generate(), CustomerId::generate());
+        $draft->addItem(ProductId::generate(), 1, new Money(300_00, Currency::CZK));
+        $draft->cancel('customer request', new \DateTimeImmutable());
+        $confirmed = $this->confirmedOrder();
+        $confirmed->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertNull($draft->refundDue());
+        self::assertNull($confirmed->refundDue());
+    }
+
+    #[Test]
+    public function paidOrderHasNoRefundDueUntilCancelled(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+
+        self::assertNull($order->refundDue());
+    }
+
+    #[Test]
+    public function secondCancelKeepsRefundDue(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertEquals(new Money(500_00, Currency::CZK), $order->refundDue());
+    }
+
+    #[Test]
+    public function refundDueIsInOrderCurrency(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+        $order->addItem(ProductId::generate(), 1, new Money(20_00, Currency::EUR));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertEquals(new Money(20_00, Currency::EUR), $order->refundDue());
+    }
+
+    private function confirmedOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::generate(), 2, new Money(300_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+
+        return $order;
+    }
+}
