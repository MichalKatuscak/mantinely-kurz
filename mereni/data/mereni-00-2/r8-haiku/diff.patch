+    #[Route('/{id}/storno', name: 'order_cancel', requirements: ['id' => Requirement::UUID], methods: ['POST'])]
+    #[IsCsrfTokenValid('order_edit')]
+    public function cancel(string $id, Request $request): Response
+    {
+        $order = $this->ownOrder($id);
+        $reason = $request->getPayload()->getString('reason', 'Zákazník zrušil objednávku');
+        $this->commandBus->dispatch(new CancelOrder($order->id, $reason));
+
+        return $this->redirectToRoute('order_detail', ['id' => $order->id->value]);
+    }
