+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Application;
+
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Application\Handler\CancelOrderHandler;
+use App\Ordering\Domain\Exception\InvalidOrderStateTransitionException;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\Test\KernelTestCase;
+use Symfony\Component\Messenger\Exception\HandlerFailedException;
+use Symfony\Component\Messenger\MessageBusInterface;
+
+#[CoversClass(CancelOrderHandler::class)]
+final class CancelOrderHandlerTest extends KernelTestCase
+{
+    private OrderRepository $orders;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        self::bootKernel();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $this->orders = self::getContainer()->get(OrderRepository::class);
+    }
+
+    #[Test]
+    public function cancelledPaidOrderKeepsRefundAndReturnsGoodsToStock(): void
+    {
+        $stockItems = self::getContainer()->get(StockItemRepository::class);
+        $keyboard = ProductId::fromString(Catalog::KEYBOARD);
+        $order = $this->paidOrder($keyboard);
+        self::assertSame(8, $stockItems->get($keyboard)->available());
+
+        $this->dispatch(new CancelOrder($order->id, 'zákazník si to rozmyslel'));
+
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        $cancelled = $this->orders->get($order->id);
+        self::assertSame(OrderStatus::Cancelled, $cancelled->status);
+        self::assertSame('zákazník si to rozmyslel', $cancelled->cancellationNote);
+        self::assertSame(500_00, $cancelled->refundDue()->amountInCents);
+        self::assertSame(10, $stockItems->get($keyboard)->available());
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $order = $this->paidOrder(ProductId::fromString(Catalog::KEYBOARD));
+        $order->ship();
+        $this->orders->save($order);
+
+        try {
+            $this->dispatch(new CancelOrder($order->id, ''));
+            self::fail('Odeslanou objednávku nejde stornovat');
+        } catch (HandlerFailedException $e) {
+            self::assertInstanceOf(InvalidOrderStateTransitionException::class, $e->getPrevious());
+        }
+
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Shipped, $this->orders->get($order->id)->status);
+    }
+
+    /** Klávesnice 2 × 300 Kč, sleva 100 Kč: zaplaceno 500 Kč. */
+    private function paidOrder(ProductId $productId): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem($productId, 2, new Money(300_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        $this->orders->save($order);
+
+        return $order;
+    }
+
+    private function dispatch(object $command): void
+    {
+        self::getContainer()->get(MessageBusInterface::class)->dispatch($command);
+    }
+}
