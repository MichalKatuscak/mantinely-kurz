+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená částku k vrácení. Peníze vrací obchod ručně.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function cancelledPaidOrderOwesPaidAmountBack(): void
+    {
+        $order = $this->confirmedOrderWithDiscount(Currency::EUR);
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertEquals(new Money(900_00, Currency::EUR), $order->refundAmount());
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderOwesNothing(): void
+    {
+        $order = $this->confirmedOrderWithDiscount(Currency::CZK);
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertNull($order->refundAmount());
+    }
+
+    #[Test]
+    public function paidOrderOwesNothingUntilCancelled(): void
+    {
+        $order = $this->confirmedOrderWithDiscount(Currency::CZK);
+        $order->markPaid();
+
+        self::assertNull($order->refundAmount());
+    }
+
+    #[Test]
+    public function secondCancelKeepsRefundAmount(): void
+    {
+        $order = $this->confirmedOrderWithDiscount(Currency::CZK);
+        $order->markPaid();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertEquals(new Money(900_00, Currency::CZK), $order->refundAmount());
+    }
+
+    /** Položky 2 × 500, sleva 100: zákazník platí 900. */
+    private function confirmedOrderWithDiscount(Currency $currency): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), $currency);
+        $order->addItem(ProductId::generate(), 2, new Money(500_00, $currency));
+        $order->applyDiscount(new Money(100_00, $currency));
+        $order->confirm();
+
+        return $order;
+    }
+}
