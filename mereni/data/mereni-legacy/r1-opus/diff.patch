diff --git a/tests/Legacy/OrderCancelTest.php b/tests/Legacy/OrderCancelTest.php
new file mode 100644
index 0000000..a0d15de
--- /dev/null
+++ b/tests/Legacy/OrderCancelTest.php
@@ -0,0 +1,121 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Legacy\Admin\OrderController;
+use App\Legacy\Http\LegacyOrdering;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(OrderController::class)]
+#[CoversClass(LegacyOrdering::class)]
+final class OrderCancelTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // stara administrace drzi spojeni v globalu, po resetu databaze ho zahodime
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        Catalog::seed($this->connection());
+
+        $staff = self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com');
+        $this->client->loginUser($staff);
+    }
+
+    #[Test]
+    public function paidOrderIsCancelledWithRefundAndStockReturned(): void
+    {
+        $orderId = $this->paidOrder(quantity: 3, discountInCents: 200_00);
+        self::assertSame(3, $this->reservedKeyboards($orderId));
+
+        $this->client->request('GET', '/admin/legacy/order', ['id' => $orderId]);
+        self::assertResponseIsSuccessful();
+        self::assertSelectorTextContains('form strong', '1 300');
+
+        $this->client->submitForm('Stornovat objednávku', ['reason' => 'zákazník si to rozmyslel']);
+
+        self::assertResponseRedirects();
+        self::assertSame('cancelled', $this->connection()->fetchOne('SELECT status FROM orders WHERE id = ?', [$orderId]));
+        self::assertSame(0, $this->reservedKeyboards($orderId));
+
+        $payload = json_decode((string) $this->connection()->fetchOne(
+            "SELECT payload FROM audit_log WHERE entity = 'order' AND entity_id = ? AND action = 'storno'",
+            [$orderId],
+        ), true);
+        self::assertSame(1300_00, $payload['refund_in_cents']);
+        self::assertSame('CZK', $payload['refund_currency']);
+        self::assertStringContainsString('Vrátit zákazníkovi', (string) $this->connection()->fetchOne(
+            'SELECT note FROM order_notes WHERE order_id = ?',
+            [$orderId],
+        ));
+    }
+
+    #[Test]
+    public function cancelledOrderOffersNoStorno(): void
+    {
+        $orderId = $this->paidOrder(quantity: 1, discountInCents: 0);
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $orderId, 'reason' => 'poprvé']);
+
+        $this->client->request('GET', '/admin/legacy/order', ['id' => $orderId]);
+
+        self::assertSelectorNotExists('input[value="Stornovat objednávku"]');
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $orderId = $this->paidOrder(quantity: 1, discountInCents: 0);
+        $this->connection()->update('orders', ['status' => 'shipped'], ['id' => $orderId]);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $orderId, 'reason' => 'pozdě']);
+
+        self::assertResponseRedirects();
+        self::assertSame('shipped', $this->connection()->fetchOne('SELECT status FROM orders WHERE id = ?', [$orderId]));
+        self::assertSame(1, $this->reservedKeyboards($orderId));
+    }
+
+    private function paidOrder(int $quantity, int $discountInCents): string
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::fromString(DemoCustomerProvider::ALICE));
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), $quantity, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money($discountInCents, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+        // request ma objednavku nacist z databaze, ne z identity mapy testu
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+
+        return $order->id->value;
+    }
+
+    private function reservedKeyboards(string $orderId): int
+    {
+        $json = (string) $this->connection()->fetchOne('SELECT reservations FROM stock_items WHERE product_id = ?', [Catalog::KEYBOARD]);
+
+        return (int) (json_decode($json, true)[$orderId] ?? 0);
+    }
+
+    private function connection(): Connection
+    {
+        return self::getContainer()->get(Connection::class);
+    }
+}
