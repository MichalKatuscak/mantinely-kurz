diff --git a/src/Legacy/Admin/OrderController.php b/src/Legacy/Admin/OrderController.php
index 4c8a41f..027188d 100644
--- a/src/Legacy/Admin/OrderController.php
+++ b/src/Legacy/Admin/OrderController.php
@@ -157,4 +157,53 @@ class OrderController extends BaseController
 
         return $this->detailAction();
     }
+
+    /**
+     * Storno objednavky: zakaznik dostane zpatky zaplacenou castku a zbozi se vrati na sklad.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+        if (is_post()) {
+            csrf_check();
+        }
+
+        $id = get_param('id');
+        $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+
+        if (is_post()) {
+            $reason = $this->post('reason', '');
+
+            try {
+                legacy_command(new \App\Ordering\Application\Command\CancelOrder(
+                    \App\Ordering\Domain\ValueObject\OrderId::fromString($id),
+                    $reason
+                ));
+            } catch (\App\Ordering\Domain\Exception\InvalidOrderStateTransitionException $e) {
+                flash('Objednávka v tomto stavu se nedá stornovat (odeslaná ani doručená ne)', 'error');
+
+                return $this->redirect(admin_url('order', array('id' => $id)));
+            }
+
+            flash('Objednávka stornována, zákazníkovi bude vrácena zaplacená částka');
+
+            return $this->redirect(admin_url('order', array('id' => $id)));
+        }
+
+        $customer = $db->one("SELECT * FROM customers WHERE id = " . $db->quote($order['customer_id']));
+        $sum = (int) $db->value("SELECT COALESCE(SUM(quantity * unit_price_amount_in_cents), 0) FROM order_items WHERE order_id = " . $db->quote($id));
+        $toPay = max(0, $sum - (int) $order['discount_amount_in_cents']);
+
+        return $this->renderLayout('orders/cancel', array(
+            'order'    => $order,
+            'customer' => $customer,
+            'sum'      => $sum,
+            'toPay'    => $toPay,
+        ), 'Storno objednávky ' . $id);
+    }
 }
