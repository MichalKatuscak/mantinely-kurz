includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - tools
    excludePaths:
        analyse:
            # Stará administrace se neanalyzuje, jen se čte kvůli typům.
            # Výjimkou je src/Legacy/Report: kód vytažený z legacy s typy (modul 10).
            - src/Legacy/Admin
            - src/Legacy/Http
            - src/Legacy/lib
            - src/Legacy/templates
            - src/Legacy/bootstrap.php
            - src/Legacy/cron.php
            - src/Legacy/export.php
        analyseAndScan:
            # Ukázky pro testy pravidel obsahují chyby záměrně.
            - tests/PHPStan/data
    tmpDir: var/cache/phpstan
    symfony:
        # Vzniká při bin/console cache:warmup, make check ho spouští před PHPStanem.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    # Z ergebnis/phpstan-rules jen zákaz komentářů, které chybu umlčí.
    ergebnis:
        allRules: false
        noPhpstanIgnore:
            enabled: true
