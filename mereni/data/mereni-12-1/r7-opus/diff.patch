@@ -0,0 +1,106 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená částku, kterou obchod vrátí zákazníkovi ručně.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function cancelledPaidOrderRecordsPaidAmountForRefund(): void
+    {
+        $order = $this->draftOrder();
+        $order->addItem(ProductId::generate(), 2, $this->czk(500_00));
+        $order->applyDiscount($this->czk(100_00));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundAmount()->equals($this->czk(900_00)));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderHasNothingToRefund(): void
+    {
+        $confirmed = $this->confirmedOrder();
+        $confirmed->cancel('customer request', new \DateTimeImmutable());
+        $draft = $this->draftOrder();
+        $draft->addItem(ProductId::generate(), 1, $this->czk(500_00));
+        $draft->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($confirmed->refundAmount()->equals($this->czk(0)));
+        self::assertTrue($draft->refundAmount()->equals($this->czk(0)));
+    }
+
+    #[Test]
+    public function paidOrderHasNothingToRefundUntilCancelled(): void
+    {
+        self::assertTrue($this->paidOrder()->refundAmount()->equals($this->czk(0)));
+    }
+
+    #[Test]
+    public function secondCancelKeepsRefundAmount(): void
+    {
+        $order = $this->paidOrder();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundAmount()->equals($this->czk(1000_00)));
+    }
+
+    #[Test]
+    public function refundIsInOrderCurrency(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+        $order->addItem(ProductId::generate(), 1, new Money(40_00, Currency::EUR));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundAmount()->equals(new Money(40_00, Currency::EUR)));
+    }
+
+    private function draftOrder(): Order
+    {
+        return Order::place(OrderId::generate(), CustomerId::generate());
+    }
+
+    private function confirmedOrder(): Order
+    {
+        $order = $this->draftOrder();
+        $order->addItem(ProductId::generate(), 2, $this->czk(500_00));
+        $order->confirm();
+
+        return $order;
+    }
+
+    private function paidOrder(): Order
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+
+        return $order;
+    }
+
+    private function czk(int $amountInCents): Money
+    {
+        return new Money($amountInCents, Currency::CZK);
+    }
+}
