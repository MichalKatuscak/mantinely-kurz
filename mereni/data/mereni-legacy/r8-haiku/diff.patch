index 86c57cb..71926e1 100644
--- a/src/Legacy/lib/functions.php
+++ b/src/Legacy/lib/functions.php
@@ -187,3 +187,64 @@ function ids_to_sql($ids)
 
     return implode(',', $out);
 }
+
+/**
+ * Storno objednávky: vrácení zboží na sklad a vrácení peněz.
+ * Vrátí true pokud bylo storno úspěšné.
+ */
+function cancel_order($orderId)
+{
+    global $db;
+    legacy_db();
+
+    $order = $db->one("SELECT * FROM orders WHERE id = '" . $orderId . "'");
+    if ($order === null) {
+        return false;
+    }
+
+    if ($order['status'] == 'delivered') {
+        return false;
+    }
+
+    if ($order['status'] == 'cancelled') {
+        return true;
+    }
+
+    $db->begin();
+    try {
+        $items = $db->query("SELECT * FROM order_items WHERE order_id = '" . $orderId . "'");
+        foreach ($items as $item) {
+            $stock = $db->one("SELECT * FROM stock_items WHERE product_id = '" . $item['product_id'] . "'");
+            if ($stock !== null) {
+                $reservations = json_decode((string) $stock['reservations'], true);
+                if (!is_array($reservations)) {
+                    $reservations = array();
+                }
+
+                $newOnHand = (int) $stock['on_hand'] + (int) $item['quantity'];
+                unset($reservations[$orderId]);
+
+                $db->exec("UPDATE stock_items SET on_hand = " . $newOnHand . ", reservations = " . $db->quote(json_encode($reservations)) . " WHERE product_id = '" . $item['product_id'] . "'");
+            }
+        }
+
+        $total = order_total($orderId);
+        $refund = $total - (int) $order['discount_amount_in_cents'];
+        if ($refund < 0) {
+            $refund = 0;
+        }
+
+        $db->exec("UPDATE orders SET status = 'cancelled' WHERE id = '" . $orderId . "'");
+        audit_log('order', $orderId, 'cancel', array(
+            'from' => $order['status'],
+            'refund_cents' => $refund,
+            'refund_currency' => $order['currency'],
+        ));
+
+        $db->commit();
+        return true;
+    } catch (\Exception $e) {
+        $db->rollback();
+        return false;
+    }
+}
