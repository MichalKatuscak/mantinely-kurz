+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Application\Handler;
+
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+/**
+ * Rezervace uvolní Inventory na událost OrderCancelled. Peníze se vracejí
+ * ručně, handler jen vrátí částku, kterou má obchod zákazníkovi poslat.
+ */
+#[AsMessageHandler(bus: 'command.bus')]
+final readonly class CancelOrderHandler
+{
+    public function __construct(
+        private OrderRepository $orders,
+    ) {}
+
+    /** @return int částka k vrácení v haléřích v měně objednávky, 0 = nic nevracet */
+    public function __invoke(CancelOrder $command): int
+    {
+        $order = $this->orders->get($command->orderId);
+        // Vrací se jen zaplacené. Opakované storno nevrací nic podruhé.
+        $refund = $order->status === OrderStatus::Paid ? $order->paidAmount()->amountInCents : 0;
+
+        $order->cancel($command->reason, new \DateTimeImmutable());
+        $this->orders->save($order);
+
+        return $refund;
+    }
+}
diff --git a/tests/Acceptance/Legacy/CancelOrderTest.php b/tests/Acceptance/Legacy/CancelOrderTest.php
new file mode 100644
index 0000000..f069944
--- /dev/null
+++ b/tests/Acceptance/Legacy/CancelOrderTest.php
@@ -0,0 +1,133 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Acceptance\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+/**
+ * Storno ze staré administrace: zákazník dostane zpět zaplacenou částku
+ * (obchod ji vrací ručně podle poznámky u objednávky) a zboží se vrátí na sklad.
+ */
+final class CancelOrderTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // stará administrace drží spojení v globální proměnné
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        $this->client->disableReboot();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $this->client->loginUser(
+            self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com'),
+        );
+    }
+
+    #[Test]
+    public function paidOrderIsCancelledWithRefundNoteAndGoodsBackInStock(): void
+    {
+        // příprava: zaplacená objednávka, klávesnice 2 × 300 Kč, sleva 100 Kč
+        $order = $this->order();
+        $order->confirm();
+        $order->markPaid();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        // akce: obsluha stornuje z detailu objednávky
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        $this->client->submitForm('Stornovat', ['reason' => 'Zákazník si to rozmyslel']);
+
+        // ověření: stav, poznámka s částkou k vrácení, zboží zpět na skladě
+        self::assertSelectorTextContains('.flash', 'zákazníkovi vraťte 500,00 Kč');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        $cancelled = self::getContainer()->get(OrderRepository::class)->get($order->id);
+        self::assertSame(OrderStatus::Cancelled, $cancelled->status);
+        self::assertSame('Zákazník si to rozmyslel', $cancelled->cancellationNote);
+
+        $notes = self::getContainer()->get(Connection::class)
+            ->fetchFirstColumn('SELECT note FROM order_notes WHERE order_id = ?', [$order->id->value]);
+        self::assertSame(['Storno: vrátit zákazníkovi 500,00 Kč (ručně)'], $notes);
+
+        $stock = self::getContainer()->get(StockItemRepository::class)->get(ProductId::fromString(Catalog::KEYBOARD));
+        self::assertSame(10, $stock->available());
+    }
+
+    #[Test]
+    public function unpaidOrderIsCancelledWithoutRefundNote(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        $this->client->submitForm('Stornovat');
+
+        self::assertSelectorTextContains('.flash', 'Objednávka stornována');
+        self::assertSelectorTextNotContains('.flash', 'vraťte');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Cancelled, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+        self::assertSame([], self::getContainer()->get(Connection::class)
+            ->fetchFirstColumn('SELECT note FROM order_notes WHERE order_id = ?', [$order->id->value]));
+    }
+
+    #[Test]
+    public function shippedOrderStaysShipped(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        $order->markPaid();
+        $order->ship();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        // odeslaná objednávka formulář nemá, požadavek se pošle přímo
+        $token = $this->client->request('GET', '/admin/legacy/orders')->filter('input[name="_csrf"]')->first()->attr('value');
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$order->id->value, ['_csrf' => $token]);
+
+        self::assertSelectorTextContains('.flash.error', 'nejde stornovat');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Shipped, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+        self::assertSame([], self::getContainer()->get(Connection::class)
+            ->fetchFirstColumn('SELECT note FROM order_notes WHERE order_id = ?', [$order->id->value]));
+    }
+
+    #[Test]
+    public function cancelWithoutCsrfTokenIsRejected(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$order->id->value, ['reason' => 'x']);
+
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Confirmed, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+    }
+
+    private function order(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 2, new Money(300_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+
+        return $order;
+    }
+}
