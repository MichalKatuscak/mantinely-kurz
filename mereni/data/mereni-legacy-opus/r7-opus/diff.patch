diff --git a/src/Legacy/lib/OrderCancellation.php b/src/Legacy/lib/OrderCancellation.php
new file mode 100644
index 0000000..cb82fb9
--- /dev/null
+++ b/src/Legacy/lib/OrderCancellation.php
@@ -0,0 +1,145 @@
+<?php
+/**
+ * Storno jedne objednavky z detailu v administraci (2026).
+ *
+ * V jedne transakci:
+ *   - prepne objednavku na 'cancelled',
+ *   - zaplacene objednavce zapise vratku zaplacene castky (order_refunds),
+ *   - uvolni rezervace objednavky ve skladu (stock_items.reservations),
+ * a po commitu posle zakaznikovi mail.
+ *
+ * Stornovat jde jen to, co dovoli novy e-shop (OrderStatus::allowedTransitions):
+ * rozpracovanou, potvrzenou a zaplacenou objednavku. Odeslanou ne.
+ *
+ * Hromadne storno (orders.php) a zmena stavu v order_edit.php tohle nedelaji.
+ */
+
+namespace App\Legacy\lib;
+
+class OrderCancellation
+{
+    const CANCELLABLE = array('draft', 'confirmed', 'paid');
+
+    /**
+     * Vraci array('ok' => bool, 'error' => string|null, 'refund' => halere|null, 'released' => pocet produktu).
+     */
+    public static function cancel($orderId, $reason = '')
+    {
+        global $db;
+        legacy_db();
+
+        $result = array('ok' => false, 'error' => null, 'refund' => null, 'released' => 0);
+
+        $db->begin();
+        try {
+            $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($orderId));
+            if ($order === null) {
+                $db->rollback();
+                $result['error'] = 'Objednávka neexistuje';
+
+                return $result;
+            }
+            if (!self::canCancel($order['status'])) {
+                $db->rollback();
+                $result['error'] = 'Objednávku ve stavu „' . order_state_label($order['status']) . '“ nelze stornovat';
+
+                return $result;
+            }
+
+            // podminka na puvodni stav: kdyz ji mezitim nekdo zmenil, nic neprepiseme
+            $n = $db->exec("UPDATE orders SET status = 'cancelled' WHERE id = " . $db->quote($orderId)
+                . " AND status = " . $db->quote($order['status']));
+            if ($n != 1) {
+                $db->rollback();
+                $result['error'] = 'Objednávku mezitím někdo změnil, zkuste to znovu';
+
+                return $result;
+            }
+
+            // vracime jen to, co zakaznik zaplatil: polozky po sleve (stejne jako faktura a "K úhradě")
+            if ($order['status'] == 'paid') {
+                $amount = order_total_after_discount($orderId);
+                $db->exec("INSERT INTO order_refunds (order_id, amount_cents, currency, reason, author, created_at) VALUES ("
+                    . $db->quote($orderId) . ", "
+                    . (int) $amount . ", "
+                    . $db->quote($order['currency']) . ", "
+                    . $db->quote($reason !== '' ? $reason : null) . ", "
+                    . $db->quote(auth_login_name()) . ", "
+                    . "'" . date('Y-m-d H:i:s') . "')");
+                $result['refund'] = $amount;
+            }
+
+            $result['released'] = self::releaseReservations($orderId);
+
+            audit_log('order', $orderId, 'storno', array(
+                'from'     => $order['status'],
+                'reason'   => $reason,
+                'refund'   => $result['refund'],
+                'released' => $result['released'],
+            ));
+
+            $db->commit();
+        } catch (\Exception $e) {
+            $db->rollback();
+            throw $e;
+        }
+
+        cache_delete('dashboard_stats');
+        self::notifyCustomer($order, $result['refund']);
+        $result['ok'] = true;
+
+        return $result;
+    }
+
+    public static function canCancel($status)
+    {
+        return in_array($status, self::CANCELLABLE, true);
+    }
+
+    /**
+     * Vratka k objednavce nebo null.
+     */
+    public static function refund($orderId)
+    {
+        global $db;
+        legacy_db();
+
+        return $db->one("SELECT * FROM order_refunds WHERE order_id = " . $db->quote($orderId));
+    }
+
+    /**
+     * Smaze rezervace objednavky ze vsech skladovych polozek (zbozi je zase k dispozici).
+     * Stejne jako StockItem::release() v novem e-shopu. Vraci pocet dotcenych produktu.
+     */
+    private static function releaseReservations($orderId)
+    {
+        global $db;
+        $released = 0;
+        foreach ($db->query("SELECT product_id, reservations FROM stock_items") as $r) {
+            $data = json_decode((string) $r['reservations'], true);
+            if (!is_array($data) || !array_key_exists($orderId, $data)) {
+                continue;
+            }
+            unset($data[$orderId]);
+            $db->exec("UPDATE stock_items SET reservations = " . $db->quote(json_encode($data))
+                . " WHERE product_id = " . $db->quote($r['product_id']));
+            $released++;
+        }
+
+        return $released;
+    }
+
+    private static function notifyCustomer($order, $refund)
+    {
+        global $db;
+        $c = $db->one("SELECT email FROM customers WHERE id = " . $db->quote($order['customer_id']));
+        if ($c === null) {
+            return;
+        }
+        $body = "Dobrý den,\n\nvaše objednávka " . $order['id'] . " byla stornována.\n";
+        if ($refund !== null) {
+            $body .= "Zaplacenou částku " . format_price($refund, $order['currency']) . " vám vrátíme.\n";
+        }
+        send_mail($c['email'], 'Objednávka byla stornována', $body);
+    }
+}
