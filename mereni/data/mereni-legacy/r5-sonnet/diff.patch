+    /**
+     * Storno objednavky (POST z detailu): objednavka prejde do stavu cancelled,
+     * novy e-shop uvolni rezervace zbozi ve skladu. Zaplacena castka se zakaznikovi
+     * vraci mimo tento system (platebni brana tu neni), proto jen jde do historie.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+
+        $id = post_param('id');
+        if (!is_post() || $id == '') {
+            redirect(admin_url('orders'));
+
+            return;
+        }
+        // flash se mezi pozadavky neuklada, proto misto presmerovani rovnou detail
+        $_GET['id'] = $id;
+
+        $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+        if ($order['status'] == 'cancelled') {
+            flash('Objednávka je už stornovaná.', 'error');
+
+            return $this->detailAction();
+        }
+        if (in_array($order['status'], array('shipped', 'delivered'))) {
+            flash('Odeslanou nebo doručenou objednávku nelze stornovat.', 'error');
+
+            return $this->detailAction();
+        }
+
+        // vratit se ma jen to, co zakaznik skutecne zaplatil (po sleve)
+        $refund = $order['status'] == 'paid' ? order_total_after_discount($id) : 0;
+
+        $reason = trim(post_param('reason'));
+        try {
+            $GLOBALS['LEGACY_COMMAND_BUS']->dispatch(new CancelOrder(
+                OrderId::fromString($id),
+                $reason != '' ? $reason : 'Storno ve správě',
+                new \DateTimeImmutable()
+            ));
+        } catch (HandlerFailedException $e) {
+            flash('Storno se nepodařilo: ' . $e->getPrevious()->getMessage(), 'error');
+
+            return $this->detailAction();
+        }
+
+        audit_log('order', $id, 'storno', array('from' => $order['status'], 'refund_cents' => $refund, 'reason' => $reason));
+        cache_delete('dashboard_stats');
+
+        $msg = 'Objednávka stornována, zboží se vrátilo na sklad.';
+        if ($refund > 0) {
+            $msg .= ' Zákazníkovi vraťte ' . format_price($refund, $order['currency']) . '.';
+        }
+        flash($msg);
+
+        return $this->detailAction();
+    }
+
     /**
      * Objednavky zakaznika (volano z detailu zakaznika pres AJAX, 2016).
      */
