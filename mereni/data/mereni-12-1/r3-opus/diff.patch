+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená, kolik má obchod zákazníkovi vrátit.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function newOrderHasNothingToRefund(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+
+        self::assertTrue(Money::zero(Currency::EUR)->equals($order->refundDue));
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRecordsPaidAmountAfterDiscount(): void
+    {
+        // 2 × 300 Kč, sleva 100 Kč: zaplaceno 500 Kč
+        $order = $this->confirmedOrder(Currency::CZK, 300_00, 2, 100_00);
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue(new Money(500_00, Currency::CZK)->equals($order->refundDue));
+    }
+
+    #[Test]
+    public function refundIsInOrderCurrency(): void
+    {
+        $order = $this->confirmedOrder(Currency::EUR, 40_00, 1, 0);
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue(new Money(40_00, Currency::EUR)->equals($order->refundDue));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderHasNothingToRefund(): void
+    {
+        $order = $this->confirmedOrder(Currency::CZK, 300_00, 2, 0);
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue(Money::zero(Currency::CZK)->equals($order->refundDue));
+    }
+
+    #[Test]
+    public function secondCancelKeepsRecordedRefund(): void
+    {
+        $order = $this->confirmedOrder(Currency::CZK, 300_00, 2, 0);
+        $order->markPaid();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('again', new \DateTimeImmutable());
+
+        self::assertTrue(new Money(600_00, Currency::CZK)->equals($order->refundDue));
+    }
+
+    private function confirmedOrder(Currency $currency, int $unitPrice, int $quantity, int $discount): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), $currency);
+        $order->addItem(ProductId::generate(), $quantity, new Money($unitPrice, $currency));
+        $order->applyDiscount(new Money($discount, $currency));
+        $order->confirm();
+
+        return $order;
+    }
+}
