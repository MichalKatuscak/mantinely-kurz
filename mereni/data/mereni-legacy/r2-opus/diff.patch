diff --git a/src/Legacy/Http/OrderingGateway.php b/src/Legacy/Http/OrderingGateway.php
new file mode 100644
index 0000000..ea66601
--- /dev/null
+++ b/src/Legacy/Http/OrderingGateway.php
@@ -0,0 +1,38 @@
+<?php
+/**
+ * Prikazy, ktere stara administrace posila novemu e-shopu (2026).
+ *
+ * Stara administrace stav objednavek sama v SQL nemeni tam, kde na zmenu
+ * navazuje dalsi logika (sklad, vraceni penez). LegacyFrontController
+ * tuhle tridu da stranky do $GLOBALS['LEGACY_ORDERING'].
+ */
+
+namespace App\Legacy\Http;
+
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\ValueObject\OrderId;
+use Symfony\Component\Messenger\Exception\HandlerFailedException;
+use Symfony\Component\Messenger\MessageBusInterface;
+
+class OrderingGateway
+{
+    public function __construct(
+        private readonly MessageBusInterface $commandBus,
+    ) {}
+
+    /**
+     * Storno: uvolni rezervace ve skladu a u zaplacene objednavky zapise
+     * castku k vraceni (orders.refund_amount_in_cents).
+     *
+     * @throws \DomainException kdyz objednavku v jejim stavu stornovat nejde
+     */
+    public function cancelOrder($orderId, $reason)
+    {
+        try {
+            $this->commandBus->dispatch(new CancelOrder(OrderId::fromString($orderId), $reason));
+        } catch (HandlerFailedException $e) {
+            // stranky chteji puvodni vyjimku z domeny, ne obal z Messengeru
+            throw $e->getPrevious() ?? $e;
+        }
+    }
+}
