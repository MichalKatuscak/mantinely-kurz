+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená, kolik zákazníkovi vrátit.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function cancelledPaidOrderRefundsPaidAmount(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        // 2 × 500 Kč, sleva 100 Kč
+        self::assertTrue($order->refund->equals($this->czk(900_00)));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderRefundsNothing(): void
+    {
+        $confirmed = $this->confirmedOrder();
+        $confirmed->cancel('customer request', new \DateTimeImmutable());
+        $draft = $this->draftOrder();
+        $draft->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($confirmed->refund->equals($this->czk(0)));
+        self::assertTrue($draft->refund->equals($this->czk(0)));
+    }
+
+    #[Test]
+    public function secondCancelKeepsRefund(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refund->equals($this->czk(900_00)));
+    }
+
+    #[Test]
+    public function refundIsInOrderCurrency(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+        $order->addItem(ProductId::generate(), 1, new Money(20_00, Currency::EUR));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refund->equals(new Money(20_00, Currency::EUR)));
+    }
+
+    #[Test]
+    public function newOrderHasNoRefund(): void
+    {
+        self::assertTrue($this->draftOrder()->refund->equals($this->czk(0)));
+    }
+
+    private function draftOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::generate(), 2, $this->czk(500_00));
