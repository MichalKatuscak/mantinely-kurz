+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Event\OrderCancelled;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaznamená, kolik vrátit zákazníkovi (docs/plany/storno.md).
+ */
+#[CoversClass(Order::class)]
+final class OrderCancellationTest extends TestCase
+{
+    #[Test]
+    public function newOrderHasNothingToRefund(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+
+        self::assertTrue($order->refund->equals(Money::zero(Currency::EUR)));
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRefundsPaidAmount(): void
+    {
+        $order = $this->order(Currency::EUR);
+        $order->markPaid();
+        $order->releaseEvents();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $expected = new Money(500_00, Currency::EUR);
+        self::assertTrue($order->refund->equals($expected));
+        $event = $order->releaseEvents()[0];
+        self::assertInstanceOf(OrderCancelled::class, $event);
+        self::assertTrue($event->refund->equals($expected));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderRefundsNothing(): void
+    {
+        $order = $this->order(Currency::EUR);
+        $order->releaseEvents();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refund->equals(Money::zero(Currency::EUR)));
