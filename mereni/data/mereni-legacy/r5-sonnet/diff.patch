--- /dev/null
+++ b/src/Ordering/Application/Handler/CancelOrderHandler.php
@@ -0,0 +1,24 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Application\Handler;
+
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\Repository\OrderRepository;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+#[AsMessageHandler(bus: 'command.bus')]
+final readonly class CancelOrderHandler
+{
+    public function __construct(
+        private OrderRepository $orders,
+    ) {}
+
+    public function __invoke(CancelOrder $command): void
+    {
+        $order = $this->orders->get($command->orderId);
+        $order->cancel($command->reason, $command->when);
+        $this->orders->save($order);
+    }
+}
diff --git a/tests/Legacy/CancelOrderTest.php b/tests/Legacy/CancelOrderTest.php
new file mode 100644
index 0000000..ea4cbf5
--- /dev/null
+++ b/tests/Legacy/CancelOrderTest.php
@@ -0,0 +1,86 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Legacy\Http\LegacyFrontController;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(LegacyFrontController::class)]
+final class CancelOrderTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        $this->client = self::createClient();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $this->client->loginUser(
+            self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com'),
+        );
+    }
+
+    #[Test]
+    public function staffCancelsPaidOrderAndStockIsReleased(): void
+    {
+        $keyboard = ProductId::fromString(Catalog::KEYBOARD);
+        $order = $this->paidOrder($keyboard);
+        self::assertSame(7, self::getContainer()->get(StockItemRepository::class)->get($keyboard)->available());
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value, 'reason' => 'zákazník si to rozmyslel']);
+
+        self::assertResponseIsSuccessful();
+        self::assertSelectorTextContains('body', 'Objednávka stornována');
+        // 3 × 500 Kč po slevě 100 Kč
+        self::assertSelectorTextContains('body', 'Zákazníkovi vraťte');
+        self::assertStringContainsString('1 400', (string) $this->client->getResponse()->getContent());
+
+        self::getContainer()->get('doctrine')->getManager()->clear();
+        self::assertSame(OrderStatus::Cancelled, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+        self::assertSame(10, self::getContainer()->get(StockItemRepository::class)->get($keyboard)->available());
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $order = $this->paidOrder(ProductId::fromString(Catalog::KEYBOARD));
+        $order->ship();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value]);
+
+        self::assertSelectorTextContains('body', 'nelze stornovat');
+        self::assertSame(OrderStatus::Shipped, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+    }
+
+    private function paidOrder(ProductId $productId): Order
+    {
+        $orders = self::getContainer()->get(OrderRepository::class);
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem($productId, 3, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        $orders->save($order);
+
+        return $order;
+    }
+}
