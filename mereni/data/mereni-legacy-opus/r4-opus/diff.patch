diff --git a/tests/Legacy/OrderCancelTest.php b/tests/Legacy/OrderCancelTest.php
new file mode 100644
index 0000000..c937a43
--- /dev/null
+++ b/tests/Legacy/OrderCancelTest.php
@@ -0,0 +1,117 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Legacy\Admin\OrderController;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(OrderController::class)]
+final class OrderCancelTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // Stará administrace drží spojení v globální proměnné.
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $user = self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com');
+        $this->client->loginUser($user);
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRefundsPaidAmountAndReleasesStock(): void
+    {
+        $order = $this->paidOrder();
+        self::assertSame(7, $this->available(Catalog::KEYBOARD));
+
+        $this->client->request('GET', '/admin/legacy/order', ['id' => $order->id->value]);
+        $this->client->submitForm('Stornovat objednávku', ['reason' => 'zákazník si to rozmyslel']);
+
+        self::assertResponseRedirects('/admin/legacy/order?id='.$order->id->value);
+        self::assertSame(OrderStatus::Cancelled, $this->reload($order)->status);
+        self::assertSame(10, $this->available(Catalog::KEYBOARD));
+        $audit = json_decode((string) $this->connection()->fetchOne(
+            "SELECT payload FROM audit_log WHERE entity = 'order' AND entity_id = ? AND action = 'storno'",
+            [$order->id->value],
+        ), true);
+        self::assertSame(1400_00, $audit['refund']);
+        self::assertStringContainsString('Vrátit zákazníkovi 1 400,00 Kč', (string) $this->connection()->fetchOne(
+            'SELECT note FROM order_notes WHERE order_id = ?',
+            [$order->id->value],
+        ));
+    }
+
+    #[Test]
+    public function shippedOrderIsNotCancelled(): void
+    {
+        $order = $this->paidOrder();
+        $order->ship();
+        $this->orders()->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value]);
+
+        self::assertResponseRedirects();
+        self::assertSame(OrderStatus::Shipped, $this->reload($order)->status);
+        self::assertSame(7, $this->available(Catalog::KEYBOARD));
+        self::assertFalse($this->connection()->fetchOne("SELECT 1 FROM audit_log WHERE action = 'storno'"));
+    }
+
+    /** Tři klávesnice po 500 Kč se slevou 100 Kč, zaplaceno 1 400 Kč. */
+    private function paidOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 3, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        $this->orders()->save($order);
+
+        return $order;
+    }
+
+    private function reload(Order $order): Order
+    {
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+
+        return $this->orders()->get($order->id);
+    }
+
+    private function available(string $productId): int
+    {
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+
+        return self::getContainer()->get(StockItemRepository::class)->get(ProductId::fromString($productId))->available();
+    }
+
+    private function orders(): OrderRepository
+    {
+        return self::getContainer()->get(OrderRepository::class);
+    }
+
+    private function connection(): Connection
+    {
+        return self::getContainer()->get(Connection::class);
+    }
+}
