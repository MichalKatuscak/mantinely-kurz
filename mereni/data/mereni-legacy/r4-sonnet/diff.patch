         ), 'Objednávka ' . $id);
     }
 
+    /**
+     * Storno objednavky: stav cancelled, uvolneni rezervaci ve skladu a vraceni
+     * zaplacene castky zakaznikovi. Stejna pravidla jako Order::cancel() –
+     * odeslanou a dorucenou objednavku nelze stornovat.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+
+        $id = post_param('id');
+        $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+
+        $back = admin_url('order', array('id' => $id));
+        if ($order['status'] == 'cancelled') {
+            flash('Objednávka už je stornovaná.', 'error');
+
+            return $this->redirect($back);
+        }
+        if (!in_array($order['status'], array('draft', 'confirmed', 'paid'))) {
+            flash('Odeslanou nebo doručenou objednávku nelze stornovat.', 'error');
+
+            return $this->redirect($back);
+        }
+
+        // vracime jen to, co zakaznik skutecne zaplatil
+        $refund = $order['status'] == 'paid' ? order_total_after_discount($id) : 0;
+
+        $db->begin();
+        try {
+            $db->exec("UPDATE orders SET status = 'cancelled' WHERE id = " . $db->quote($id));
+
+            // vratit zbozi na sklad = uvolnit rezervace teto objednavky
+            $released = array();
+            foreach ($db->query("SELECT product_id, reservations FROM stock_items") as $s) {
+                $data = json_decode((string) $s['reservations'], true);
+                if (!is_array($data) || !isset($data[$id])) {
+                    continue;
+                }
+                $released[$s['product_id']] = (int) $data[$id];
+                unset($data[$id]);
+                $db->exec("UPDATE stock_items SET reservations = " . $db->quote(json_encode((object) $data))
+                    . " WHERE product_id = " . $db->quote($s['product_id']));
+            }
+
+            audit_log('order', $id, 'storno', array(
+                'from'     => $order['status'],
+                'refund'   => $refund,
+                'currency' => $order['currency'],
+                'released' => $released,
+            ));
+            if ($refund > 0) {
+                $db->exec("INSERT INTO order_notes (order_id, author, note, created_at) VALUES ("
+                    . $db->quote($id) . ", " . $db->quote(auth_login_name()) . ", "
+                    . $db->quote('Storno: k vrácení zákazníkovi ' . format_price($refund, $order['currency'])) . ", "
+                    . "'" . date('Y-m-d H:i:s') . "')");
+            }
+            $db->commit();
+        } catch (\Throwable $e) {
+            $db->rollback();
+            throw $e;
+        }
+
+        $c = $db->one("SELECT email FROM customers WHERE id = " . $db->quote($order['customer_id']));
+        if ($c) {
+            $body = "Dobrý den,\n\nvaše objednávka " . $id . " byla stornována.\n";
+            if ($refund > 0) {
+                $body .= "Zaplacenou částku " . format_price($refund, $order['currency']) . " vám vrátíme.\n";
+            }
+            send_mail($c['email'], 'Objednávka byla stornována', $body);
+        }
+
+        cache_delete('dashboard_stats');
+        flash('Objednávka stornována.' . ($refund > 0 ? ' K vrácení zákazníkovi: ' . format_price($refund, $order['currency']) . '.' : ''));
+
+        return $this->redirect($back);
+    }
+
