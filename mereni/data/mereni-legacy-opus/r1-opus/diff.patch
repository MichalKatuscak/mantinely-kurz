@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Legacy\Admin\OrderController;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(OrderController::class)]
+final class OrderCancelTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // Stará administrace drží spojení v globální proměnné; po resetu databáze nové.
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $this->client->loginUser(
+            self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com'),
+        );
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRefundsCustomerAndReturnsGoodsToStock(): void
+    {
+        $order = $this->order(paid: true);
+        self::assertSame(7, $this->availableKeyboards());
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value, 'reason' => 'zákazník si to rozmyslel']);
+
+        self::assertResponseIsSuccessful();
+        self::assertSelectorTextContains('.flash', 'Vrátit zákazníkovi');
+        $row = $this->orderRow($order->id);
+        self::assertSame('cancelled', $row['status']);
+        self::assertSame(1400_00, (int) $row['refund_amount_in_cents']);
+        self::assertSame(10, $this->availableKeyboards());
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderRefundsNothing(): void
+    {
+        $order = $this->order(paid: false);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value]);
+
+        $row = $this->orderRow($order->id);
+        self::assertSame('cancelled', $row['status']);
+        self::assertSame(0, (int) $row['refund_amount_in_cents']);
+        self::assertSame(10, $this->availableKeyboards());
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $order = $this->order(paid: true);
+        $order->ship();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value]);
+
+        self::assertSelectorTextContains('.flash.error', 'nelze stornovat');
+        self::assertSame('shipped', $this->orderRow($order->id)['status']);
+        self::assertSame(7, $this->availableKeyboards());
+    }
+
+    private function order(bool $paid): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 3, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        if ($paid) {
+            $order->markPaid();
+        }
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        return $order;
+    }
+
+    /** @return array<string, mixed> */
+    private function orderRow(OrderId $id): array
+    {
+        return self::getContainer()->get(Connection::class)
+            ->fetchAssociative('SELECT * FROM orders WHERE id = ?', [$id->value]) ?: [];
+    }
+
+    private function availableKeyboards(): int
+    {
+        $row = self::getContainer()->get(Connection::class)
+            ->fetchAssociative('SELECT on_hand, reservations FROM stock_items WHERE product_id = ?', [Catalog::KEYBOARD]);
+
+        return (int) $row['on_hand'] - array_sum(json_decode($row['reservations'], true));
+    }
+}
