--- /dev/null
+++ b/src/Ordering/Application/Handler/CancelOrderHandler.php
@@ -0,0 +1,24 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Application\Handler;
+
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\Repository\OrderRepository;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+#[AsMessageHandler(bus: 'command.bus')]
+final readonly class CancelOrderHandler
+{
+    public function __construct(
+        private OrderRepository $orders,
+    ) {}
+
+    public function __invoke(CancelOrder $command): void
+    {
+        $order = $this->orders->get($command->orderId);
+        $order->cancel($command->reason, new \DateTimeImmutable());
+        $this->orders->save($order);
+    }
+}
diff --git a/tests/Ordering/Application/CancelOrderTest.php b/tests/Ordering/Application/CancelOrderTest.php
new file mode 100644
index 0000000..584636d
--- /dev/null
+++ b/tests/Ordering/Application/CancelOrderTest.php
@@ -0,0 +1,81 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Application;
+
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\Exception\InvalidOrderStateTransitionException;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\Test\KernelTestCase;
+use Symfony\Component\Messenger\MessageBusInterface;
+
+final class CancelOrderTest extends KernelTestCase
+{
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        self::bootKernel();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+    }
+
+    #[Test]
+    public function commandCancelsConfirmedOrderAndReleasesReservations(): void
+    {
+        $orders = self::getContainer()->get(OrderRepository::class);
+        $stockItems = self::getContainer()->get(StockItemRepository::class);
+        $messageBus = self::getContainer()->get(MessageBusInterface::class);
+        $keyboard = ProductId::fromString(Catalog::KEYBOARD);
+
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem($keyboard, 2, new Money(500_00, Currency::CZK));
+        $orders->save($order);
+        $order->confirm();
+        $order->releaseEvents();
+        $orders->save($order);
+
+        // Po addItem se zboží rezervuje (10 - 2 = 8 dostupných)
+        self::assertSame(8, $stockItems->get($keyboard)->available());
+
+        $command = new CancelOrder($order->id, 'customer request');
+        $messageBus->dispatch($command);
+
+        $cancelled = $orders->get($order->id);
+        self::assertSame(OrderStatus::Cancelled, $cancelled->status);
+        // Po cancel se rezervace uvolní (10 dostupných)
+        self::assertSame(10, $stockItems->get($keyboard)->available());
+    }
+
+    #[Test]
+    public function commandCancelsDraftOrder(): void
+    {
+        $orders = self::getContainer()->get(OrderRepository::class);
+        $messageBus = self::getContainer()->get(MessageBusInterface::class);
+        $keyboard = ProductId::fromString(Catalog::KEYBOARD);
+
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem($keyboard, 1, new Money(500_00, Currency::CZK));
+        $order->releaseEvents();
+        $orders->save($order);
+
+        self::assertSame(OrderStatus::Draft, $order->status);
+
+        $command = new CancelOrder($order->id, 'customer changed mind');
+        $messageBus->dispatch($command);
+
+        $cancelled = $orders->get($order->id);
+        self::assertSame(OrderStatus::Cancelled, $cancelled->status);
+    }
+}
