diff --git a/src/Legacy/Http/LegacyOrdering.php b/src/Legacy/Http/LegacyOrdering.php
new file mode 100644
index 0000000..f14a793
--- /dev/null
+++ b/src/Legacy/Http/LegacyOrdering.php
@@ -0,0 +1,53 @@
+<?php
+/**
+ * Most ze stare administrace do kontextu Ordering (2026).
+ *
+ * Stara administrace meni objednavky primo v SQL. Storno ale musi projit
+ * domenou: Order::cancel() spocita castku k vraceni a udalost OrderCancelled
+ * uvolni rezervace ve skladu. Stranky se k tomu dostanou pres legacy_ordering().
+ */
+
+namespace App\Legacy\Http;
+
+use App\Ordering\Application\Command\CancelOrder;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\SharedKernel\Domain\Money;
+use Symfony\Component\Messenger\Exception\HandlerFailedException;
+use Symfony\Component\Messenger\MessageBusInterface;
+
+final readonly class LegacyOrdering
+{
+    public function __construct(
+        private MessageBusInterface $commandBus,
+        private OrderRepository $orders,
+    ) {}
+
+    /**
+     * Kolik by zakaznik dostal zpet, kdyby se objednavka ted stornovala.
+     */
+    public function refundOnCancel(string $orderId): Money
+    {
+        return $this->orders->get(OrderId::fromString($orderId))->refundOnCancel();
+    }
+
+    /**
+     * Stornuje objednavku a vrati castku, kterou je treba zakaznikovi vratit.
+     *
+     * @throws \App\Ordering\Domain\Exception\InvalidOrderStateTransitionException
+     */
+    public function cancel(string $orderId, string $reason): Money
+    {
+        $id = OrderId::fromString($orderId);
+        $refund = $this->orders->get($id)->refundOnCancel();
+
+        try {
+            $this->commandBus->dispatch(new CancelOrder($id, $reason));
+        } catch (HandlerFailedException $e) {
+            // stranky chteji puvodni domenovou vyjimku, ne obal z Messengeru
+            throw $e->getPrevious() ?? $e;
+        }
+
+        return $refund;
+    }
+}
