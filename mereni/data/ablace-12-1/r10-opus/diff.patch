+    #[Test]
+    public function cancelEventCarriesOrderData(): void
+    {
+        $customerId = CustomerId::generate();
+        $order = Order::place(OrderId::generate(), $customerId);
+        $when = new \DateTimeImmutable('2026-10-10 12:00');
+
+        $order->cancel('customer request', $when);
+
+        $event = $order->releaseEvents()[1];
+        self::assertInstanceOf(OrderCancelled::class, $event);
+        self::assertTrue($event->orderId->equals($order->id));
