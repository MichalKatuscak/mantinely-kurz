+
+namespace DoctrineMigrations;
+
+use Doctrine\DBAL\Schema\Schema;
+use Doctrine\Migrations\AbstractMigration;
+
+/**
+ * Částka k vrácení po stornu (Order::$refund). Stávající objednávky nic nevracejí,
+ * měna vrácení je měna objednávky.
+ */
+final class Version20261010120000 extends AbstractMigration
+{
+    public function getDescription(): string
+    {
+        return 'Order refund after cancellation';
+    }
+
+    public function up(Schema $schema): void
+    {
+        $this->addSql('ALTER TABLE orders ADD COLUMN refund_amount_in_cents INTEGER DEFAULT 0 NOT NULL');
+        $this->addSql("ALTER TABLE orders ADD COLUMN refund_currency VARCHAR(255) DEFAULT 'CZK' NOT NULL");
+        $this->addSql('UPDATE orders SET refund_currency = currency');
+    }
+
+    public function down(Schema $schema): void
+    {
+        $this->addSql('ALTER TABLE orders DROP COLUMN refund_currency');
+        $this->addSql('ALTER TABLE orders DROP COLUMN refund_amount_in_cents');
+    }
+}
