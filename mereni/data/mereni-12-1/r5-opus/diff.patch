--- a/src/Legacy/Admin/OrderController.php
+++ b/src/Legacy/Admin/OrderController.php
@@ -157,4 +157,54 @@ class OrderController extends BaseController
 
         return $this->detailAction();
     }
+
+    /**
+     * Storno z detailu objednavky (2026).
+     *
+     * Stornuje novy e-shop (CancelOrder): hlida prechod stavu a uvolni rezervace
+     * na sklade. Penize vraci obchod rucne, tady se k objednavce zapise poznamka
+     * s castkou, kterou handler vrati.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+        if (is_post()) {
+            csrf_check();
+        }
+
+        $id = get_param('id');
+        $order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+        if (!is_post()) {
+            return $this->redirect(admin_url('order', array('id' => $id)));
+        }
+
+        try {
+            $refund = (int) legacy_command(new \App\Ordering\Application\Command\CancelOrder(
+                \App\Ordering\Domain\ValueObject\OrderId::fromString($id),
+                trim((string) $this->post('reason'))
+            ));
+        } catch (\App\Ordering\Domain\Exception\InvalidOrderStateTransitionException $e) {
+            flash('Odeslanou ani doručenou objednávku nejde stornovat', 'error');
+
+            return $this->detailAction();
+        }
+
+        if ($refund > 0) {
+            $amount = format_price($refund, $order['currency']);
+            $db->exec("INSERT INTO order_notes (order_id, author, note, created_at) VALUES ("
+                . $db->quote($id) . ", " . $db->quote(auth_login_name()) . ", "
+                . $db->quote('Storno: vrátit zákazníkovi ' . $amount . ' (ručně)') . ", "
+                . $db->quote(date('Y-m-d H:i:s')) . ")");
+            flash('Objednávka stornována, zákazníkovi vraťte ' . $amount);
+        } else {
+            flash('Objednávka stornována');
+        }
+
+        return $this->detailAction();
+    }
 }
