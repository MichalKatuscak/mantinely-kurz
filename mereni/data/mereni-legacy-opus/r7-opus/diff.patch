diff --git a/tests/Legacy/OrderCancellationTest.php b/tests/Legacy/OrderCancellationTest.php
new file mode 100644
index 0000000..ab53836
--- /dev/null
+++ b/tests/Legacy/OrderCancellationTest.php
@@ -0,0 +1,153 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Legacy\Admin\OrderController;
+use App\Legacy\lib\OrderCancellation;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(OrderCancellation::class)]
+#[CoversClass(OrderController::class)]
+final class OrderCancellationTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // stara administrace drzi spojeni v globalni promenne
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        $this->client->disableReboot();
+        Catalog::seed($this->connection());
+
+        $user = self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com');
+        $this->client->loginUser($user);
+    }
+
+    #[Test]
+    public function paidOrderIsRefundedAndGoodsReturnToStock(): void
+    {
+        $order = $this->order(discount: 100_00);
+        $order->confirm();
+        $order->markPaid();
+        $this->orders()->save($order);
+        self::assertSame(8, $this->available(Catalog::KEYBOARD));
+        self::assertSame(9, $this->available(Catalog::MOUSE));
+
+        $this->cancel($order, 'zákazník si to rozmyslel');
+
+        self::assertSame('cancelled', $this->orderStatus($order));
+        self::assertSame(10, $this->available(Catalog::KEYBOARD));
+        self::assertSame(10, $this->available(Catalog::MOUSE));
+        $refund = $this->connection()->fetchAssociative('SELECT * FROM order_refunds WHERE order_id = ?', [$order->id->value]);
+        self::assertIsArray($refund);
+        // 2 × 500 + 250 − 100 sleva
+        self::assertSame(1150_00, (int) $refund['amount_cents']);
+        self::assertSame('CZK', $refund['currency']);
+        self::assertSame('zákazník si to rozmyslel', $refund['reason']);
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        self::assertSelectorTextContains('body', 'Vráceno zákazníkovi');
+    }
+
+    #[Test]
+    public function unpaidOrderReturnsGoodsWithoutRefund(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        $this->orders()->save($order);
+
+        $this->cancel($order);
+
+        self::assertSame('cancelled', $this->orderStatus($order));
+        self::assertSame(10, $this->available(Catalog::KEYBOARD));
+        self::assertSame(0, (int) $this->connection()->fetchOne('SELECT COUNT(*) FROM order_refunds'));
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        $order->markPaid();
+        $order->ship();
+        $this->orders()->save($order);
+
+        $this->cancel($order);
+
+        self::assertSame('shipped', $this->orderStatus($order));
+        self::assertSame(8, $this->available(Catalog::KEYBOARD));
+        self::assertSame(0, (int) $this->connection()->fetchOne('SELECT COUNT(*) FROM order_refunds'));
+    }
+
+    #[Test]
+    public function secondCancellationDoesNotRefundAgain(): void
+    {
+        $order = $this->order();
+        $order->confirm();
+        $order->markPaid();
+        $this->orders()->save($order);
+
+        $this->cancel($order);
+        $this->cancel($order);
+
+        self::assertSame(1, (int) $this->connection()->fetchOne('SELECT COUNT(*) FROM order_refunds'));
+    }
+
+    private function order(int $discount = 0): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 2, new Money(500_00, Currency::CZK));
+        $order->addItem(ProductId::fromString(Catalog::MOUSE), 1, new Money(250_00, Currency::CZK));
+        $order->applyDiscount(new Money($discount, Currency::CZK));
+
+        return $order;
+    }
+
+    private function cancel(Order $order, string $reason = ''): void
+    {
+        $this->client->request('POST', '/admin/legacy/order_cancel', ['id' => $order->id->value, 'reason' => $reason]);
+        self::assertResponseRedirects('/admin/legacy/order?id='.$order->id->value);
+    }
+
+    private function orderStatus(Order $order): string
+    {
+        return (string) $this->connection()->fetchOne('SELECT status FROM orders WHERE id = ?', [$order->id->value]);
+    }
+
+    private function available(string $productId): int
+    {
+        $row = $this->connection()->fetchAssociative('SELECT on_hand, reservations FROM stock_items WHERE product_id = ?', [$productId]);
+        self::assertIsArray($row);
+
+        return (int) $row['on_hand'] - (int) array_sum(json_decode((string) $row['reservations'], true));
+    }
+
+    private function orders(): OrderRepository
+    {
+        return self::getContainer()->get(OrderRepository::class);
+    }
+
+    private function connection(): Connection
+    {
+        return self::getContainer()->get(Connection::class);
+    }
+}
