@@ -153,4 +153,58 @@ class OrderController extends BaseController
 
         return $this->detailAction();
     }
+
+    /**
+     * Storno z detailu objednavky (2026).
+     *
+     * Stornuje novy e-shop (CancelOrder): hlida prechod stavu, rezervace zbozi
+     * uvolni sklad. Platebni brana neni, castku k vraceni jen zapiseme
+     * do poznamek, penize vraci obchod rucne.
+     */
+    public function cancelAction()
+    {
+        global $db;
+        legacy_db();
+        auth_require('obchod');
+
+        $id = get_param('id');
+        if (!is_post()) {
+            return $this->redirect(admin_url('order', array('id' => $id)));
+        }
+        csrf_check();
+
+        $order = $db->one("SELECT id FROM orders WHERE id = " . $db->quote($id));
+        if ($order === null) {
+            return $this->notFound('Objednávka ' . $id . ' neexistuje');
+        }
+
+        $reason = trim((string) $this->post('reason'));
+        try {
+            $refund = legacy_command(new \App\Ordering\Application\Command\CancelOrder(
+                \App\Ordering\Domain\ValueObject\OrderId::fromString($id),
+                $reason
+            ));
+        } catch (\App\Ordering\Domain\Exception\InvalidOrderStateTransitionException $e) {
+            flash('Odeslanou ani doručenou objednávku stornovat nejde', 'error');
+
+            return $this->detailAction();
+        }
+
+        $note = 'Storno' . ($reason !== '' ? ': ' . $reason : '');
+        $toRefund = null;
+        if ($refund !== null) {
+            $toRefund = format_price($refund->amountInCents, $refund->currency->value);
+            $note .= "\nVrátit zákazníkovi " . $toRefund . ' (ručně, mimo aplikaci)';
+        }
+        $db->exec("INSERT INTO order_notes (order_id, author, note, created_at) VALUES ("
+            . $db->quote($id) . ", "
+            . $db->quote(auth_login_name()) . ", "
+            . $db->quote($note) . ", "
+            . $db->quote(date('Y-m-d H:i:s')) . ")");
+        audit_log('order', $id, 'cancel');
+
+        flash($toRefund !== null ?'Objednávka stornována, vraťte zákazníkovi ' . $toRefund : 'Objednávka stornována');
+
+        return $this->detailAction();
+    }
 }
