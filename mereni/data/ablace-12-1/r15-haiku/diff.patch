+<?php
+/**
+ * Storno objednavky – vraci zbozi na sklad a vraci penize zakaznikovi.
+ *
+ * GET /id=<uuid>
+ *   - zobrazi potvrzovaci dialog
+ *
+ * POST /id=<uuid>&confirm=1
+ *   - provede storno pres CancelOrder command
+ *   - ReleaseReservationsHandler automaticky vrati zbozi
+ *   - zapise do audit logu
+ */
+
+global $db;
+legacy_db();
+auth_require('obchod');
+
+$id = isset($_POST['id']) ? (string) $_POST['id'] : '';
+if ($id == '' && isset($_GET['id'])) {
+    $id = (string) $_GET['id'];
+}
+
+if ($id == '') {
+    flash('Chybí ID objednávky', 'error');
+    redirect(admin_url('orders'));
+    return;
+}
+
+$order = $db->one("SELECT * FROM orders WHERE id = " . $db->quote($id));
+if ($order === null) {
+    flash('Objednávka nenalezena', 'error');
+    redirect(admin_url('orders'));
+    return;
+}
+
+// kontrola, ze lze objednavku stornovat
+if ($order['status'] == 'delivered') {
+    flash('Doručenou objednávku nelze stornovat', 'error');
+    redirect(admin_url('order', array('id' => $id)));
+    return;
+}
+
+if ($order['status'] == 'cancelled') {
+    flash('Objednávka je již stornovaná', 'error');
+    redirect(admin_url('order', array('id' => $id)));
+    return;
+}
+
+// je-li GET, zobrazi potvrzovaci stranku
+if (!is_post() || !isset($_POST['confirm'])) {
+    // zobrazit potvrzovaci dialog
+    $items = $db->query("SELECT i.*, p.name FROM order_items i LEFT JOIN products p ON p.id = i.product_id WHERE i.order_id = " . $db->quote($id));
+    $customer = $db->one("SELECT * FROM customers WHERE id = " . $db->quote($order['customer_id']));
+
+    $sum = 0;
+    foreach ($items as $it) {
+        $sum += (int) ($it['quantity'] * $it['unit_price_amount_in_cents']);
+    }
+    $toPay = max(0, $sum - (int) $order['discount_amount_in_cents']);
+
+    include LEGACY_TEMPLATES . '/partials/old_header.php';
+    ?>
+    <h1>Storno objednávky <?php echo h($id); ?></h1>
+
+    <div class="warning">
+        <p><strong>Pozor!</strong> Chystáte se stornovat objednávku. Tato akce:</p>
+        <ul>
+            <li>Vrátí zboží na sklad</li>
+            <li>Vrátí peníze zákazníkovi (<?php echo h(format_price($toPay, $order['currency'])); ?>)</li>
+            <li>Bude zaznamenána v historii</li>
+        </ul>
+    </div>
+
+    <h2>Položky ke vrácení</h2>
+    <table class="grid">
+        <tr><th>Produkt</th><th class="num">Ks</th><th class="num">Cena/ks</th><th class="num">Celkem</th></tr>
+    <?php foreach ($items as $it) { ?>
+        <tr>
+            <td><?php echo h($it['name'] !== null ? $it['name'] : $it['product_id']); ?></td>
+            <td class="num"><?php echo (int) $it['quantity']; ?></td>
+            <td class="num"><?php echo format_price($it['unit_price_amount_in_cents'], $it['unit_price_currency']); ?></td>
+            <td class="num"><?php echo format_price($it['quantity'] * $it['unit_price_amount_in_cents'], $it['unit_price_currency']); ?></td>
+        </tr>
+    <?php } ?>
+    </table>
+
+    <p><strong>Zákazník:</strong>
+    <?php if ($customer) { ?>
+        <?php echo h($customer['name']); ?> &lt;<?php echo h($customer['email']); ?>&gt;
+    <?php } else { ?>
+        <em>(zákazník z nového e-shopu)</em>
+    <?php } ?>
+    </p>
+
+    <form method="post"><?php echo csrf_field(); ?>
+        <input type="hidden" name="id" value="<?php echo h($id); ?>">
+        <input type="hidden" name="confirm" value="1">
+        <p>
+            <input type="submit" value="Potvrdit storno" onclick="return confirm('Opravdu chcete stornovat tuto objednávku?')">
+            <a href="<?php echo h(admin_url('order', array('id' => $id))); ?>">Zrušit</a>
+        </p>
+    </form>
+
+    <?php
+    include LEGACY_TEMPLATES . '/partials/old_footer.php';
+    return;
+}
+
+// POST s confirm=1 – provest storno
+csrf_check();
+
+try {
+    $reason = isset($_POST['reason']) ? (string) $_POST['reason'] : 'Storno z Legacy administrace';
+
+    legacy_command(new \App\Ordering\Application\Command\CancelOrder(
+        \App\Ordering\Domain\ValueObject\OrderId::fromString($id),
+        $reason
+    ));
+
+    flash('Objednávka ' . h($id) . ' byla stornována a zboží vráceno na sklad');
+    cache_delete('dashboard_stats');
+} catch (\Exception $e) {
+    flash('Chyba při storno: ' . $e->getMessage(), 'error');
+}
+
+redirect(admin_url('order', array('id' => $id)));
