{% extends 'base.html.twig' %}

{% block title %}Objednávka {{ order.id.value }}{% endblock %}

{% block body %}
    <h1>Objednávka {{ order.id.value }}</h1>
    <p>Stav: <strong>{{ order.status.value }}</strong></p>

    <table>
        <thead>
            <tr><th>Produkt</th><th>Množství</th><th>Cena za kus</th><th>Celkem</th></tr>
        </thead>
        <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.productId.value }}</td>
                    <td>
                        {{ item.quantity }}
                        {% if order.status.value == 'draft' %}
                            <form method="post" action="{{ path('order_remove_item', {id: order.id.value, productId: item.productId.value}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('order_edit') }}">
                                <button type="submit">Odebrat</button>
                            </form>
                        {% endif %}
                    </td>
                    <td>{{ item.unitPrice|money }}</td>
                    <td>{{ item.subtotal|money }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr><th colspan="3">Součet položek</th><td>{{ order.totalAmount|money }}</td></tr>
            <tr><th colspan="3">Sleva</th><td>{{ order.discount|money }}</td></tr>
            <tr><th colspan="3">K zaplacení</th><td>{{ order.paidAmount|money }}</td></tr>
        </tfoot>
    </table>

    {% if order.status.value == 'draft' %}
        <form method="post" action="{{ path('order_add_item', {id: order.id.value}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('order_edit') }}">
            <select name="productId">
                {% for product in products %}
                    <option value="{{ product.id.value }}">{{ product.name }} ({{ product.price|money }})</option>
                {% endfor %}
            </select>
            <input type="number" name="quantity" value="1" min="1">
            <button type="submit">Přidat</button>
        </form>

        <form method="post" action="{{ path('order_confirm', {id: order.id.value}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('order_edit') }}">
            <button type="submit">Potvrdit objednávku</button>
        </form>
    {% elseif order.status.value == 'confirmed' %}
        <form method="post" action="{{ path('order_pay', {id: order.id.value}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('order_edit') }}">
            <button type="submit">Zaplatit</button>
        </form>
    {% endif %}
{% endblock %}
