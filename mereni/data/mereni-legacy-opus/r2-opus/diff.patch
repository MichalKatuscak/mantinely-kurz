@@ -0,0 +1,101 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Legacy\Admin\OrderController;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+#[CoversClass(OrderController::class)]
+final class OrderCancelTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        $this->client = self::createClient();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+
+        $staff = self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier('sprava@example.com');
+        $this->client->loginUser($staff);
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRefundsPaidAmountAndReturnsGoodsToStock(): void
+    {
+        $orderId = $this->paidOrderWithDiscount();
+        self::assertSame(8, $this->availableKeyboards());
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$orderId->value);
+        $this->client->submitForm('Stornovat objednávku', ['reason' => 'zákazník si to rozmyslel']);
+        $this->client->followRedirect();
+
+        $order = $this->order($orderId);
+        self::assertSame(OrderStatus::Cancelled, $order->status);
+        self::assertTrue($order->refund->equals(new Money(900_00, Currency::CZK)));
+        self::assertSame(10, $this->availableKeyboards());
+        self::assertSelectorTextContains('body', 'Vratka zákazníkovi900,00 Kč');
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $orderId = $this->paidOrderWithDiscount();
+        $order = $this->order($orderId);
+        $order->ship();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$orderId->value, ['reason' => 'pozdě']);
+
+        self::assertSelectorTextContains('.flash.error', 'nejde stornovat');
+        self::assertSame(OrderStatus::Shipped, $this->order($orderId)->status);
+        self::assertSame(8, $this->availableKeyboards());
+    }
+
+    private function paidOrderWithDiscount(): OrderId
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 2, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        return $order->id;
+    }
+
+    private function order(OrderId $id): Order
+    {
+        $orders = self::getContainer()->get(OrderRepository::class);
+        self::getContainer()->get('doctrine.orm.entity_manager')->clear();
+
+        return $orders->get($id);
+    }
+
+    private function availableKeyboards(): int
+    {
+        self::getContainer()->get('doctrine.orm.entity_manager')->clear();
+
+        return self::getContainer()->get(StockItemRepository::class)
+            ->get(ProductId::fromString(Catalog::KEYBOARD))
+            ->available();
+    }
+}
