@@ -0,0 +1,67 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function cancellingPaidOrderRecordsPaidAmountAsRefundDue(): void
+    {
+        $order = $this->orderWithItem();
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+
+        $order->cancel('', new \DateTimeImmutable());
+
+        self::assertSame(900_00, $order->refundDueInCents);
+    }
+
+    #[Test]
+    public function cancellingUnpaidOrderRecordsNoRefund(): void
+    {
+        $draft = $this->orderWithItem();
+        $confirmed = $this->orderWithItem();
+        $confirmed->confirm();
+
+        $draft->cancel('', new \DateTimeImmutable());
+        $confirmed->cancel('', new \DateTimeImmutable());
+
+        self::assertNull($draft->refundDueInCents);
+        self::assertNull($confirmed->refundDueInCents);
+    }
+
+    #[Test]
+    public function repeatedCancelKeepsRefund(): void
+    {
+        $order = $this->orderWithItem();
+        $order->confirm();
+        $order->markPaid();
+        $order->cancel('', new \DateTimeImmutable());
+
+        $order->cancel('', new \DateTimeImmutable());
+
+        self::assertSame(1000_00, $order->refundDueInCents);
+    }
+
+    private function orderWithItem(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::generate(), 2, new Money(500_00, Currency::CZK));
+
+        return $order;
+    }
+}
