includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - tools
    excludePaths:
        # Stará administrace se zatím neanalyzuje (modul 10).
        - src/Legacy
        # Ukázky pro testy pravidel obsahují chyby záměrně.
        - tests/PHPStan/data
    tmpDir: var/cache/phpstan
    symfony:
        # Vzniká při bin/console cache:warmup, make check ho spouští před PHPStanem.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    # Z ergebnis/phpstan-rules jen zákaz komentářů, které chybu umlčí.
    ergebnis:
        allRules: false
        noPhpstanIgnore:
            enabled: true
