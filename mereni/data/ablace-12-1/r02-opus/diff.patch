+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Acceptance\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+/**
+ * Akceptační kritéria z docs/plany/storno.md: storno ze staré administrace jde
+ * přes doménu, vrácení peněz se zapíše k objednávce, zboží se vrátí na sklad.
+ */
+final class CancelOrderTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    private OrderRepository $orders;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // stará administrace drží spojení v globální proměnné
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        $this->client->disableReboot();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+        $this->orders = self::getContainer()->get(OrderRepository::class);
+    }
+
+    #[Test]
+    public function paidOrderIsCancelledWithRefundNoteAndStockReturned(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $this->orders->save($order);
+        $keyboard = ProductId::fromString(Catalog::KEYBOARD);
+        $stockItems = self::getContainer()->get(StockItemRepository::class);
+        $availableBefore = $stockItems->get($keyboard)->available();
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        $this->client->submitForm('Stornovat', ['reason' => 'Zákazník si to rozmyslel']);
+
+        self::assertSelectorTextContains('.flash', 'vraťte zákazníkovi 500,00 Kč');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Cancelled, $this->orders->get($order->id)->status);
+        self::assertSame($availableBefore + 2, $stockItems->get($keyboard)->available());
+        self::assertSame(
+            ["Storno: Zákazník si to rozmyslel\nVrátit zákazníkovi 500,00 Kč (ručně, mimo aplikaci)"],
+            $this->notes($order->id),
+        );
+    }
+
+    #[Test]
+    public function unpaidOrderIsCancelledWithoutRefund(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->confirmedOrder();
+        $this->orders->save($order);
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        $this->client->submitForm('Stornovat');
+
+        self::assertSelectorTextContains('.flash', 'Objednávka stornována');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Cancelled, $this->orders->get($order->id)->status);
+        self::assertSame(['Storno'], $this->notes($order->id));
+    }
+
+    #[Test]
+    public function shippedOrderStaysShipped(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $order->ship();
+        $this->orders->save($order);
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        self::assertSelectorNotExists('input[value="Stornovat"]');
+
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$order->id->value, [
+            '_csrf' => $this->csrfToken(),
+        ]);
+
+        self::assertSelectorTextContains('.flash.error', 'stornovat nejde');
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Shipped, $this->orders->get($order->id)->status);
+        self::assertSame([], $this->notes($order->id));
+    }
+
+    #[Test]
+    public function warehouseStaffCannotCancel(): void
+    {
+        $this->loginAs('sklad@example.com');
+        $order = $this->confirmedOrder();
+        $this->orders->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$order->id->value, [
+            '_csrf' => $this->csrfToken(),
+        ]);
+
+        self::assertResponseStatusCodeSame(403);
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Confirmed, $this->orders->get($order->id)->status);
+    }
+
+    #[Test]
+    public function cancellationWithoutCsrfTokenIsRejected(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->confirmedOrder();
+        $this->orders->save($order);
+
+        $this->client->request('POST', '/admin/legacy/order_cancel?id='.$order->id->value);
+
+        self::assertResponseStatusCodeSame(403);
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+        self::assertSame(OrderStatus::Confirmed, $this->orders->get($order->id)->status);
+    }
+
+    private function loginAs(string $email): void
+    {
+        $this->client->loginUser(
+            self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier($email),
+        );
+    }
+
+    // klávesnice 2 × 300 Kč, sleva 100 Kč: zákazník platí 500 Kč
+    private function confirmedOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 2, new Money(300_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+
+        return $order;
+    }
+
+    // token ze session, jak ho do formulářů dává csrf_field()
+    private function csrfToken(): string
+    {
+        $this->client->request('GET', '/admin/legacy/dashboard');
+
+        $token = $this->client->getRequest()->getSession()->get('legacy_csrf_token');
+        self::assertIsString($token);
+
+        return $token;
+    }
+
+    /** @return list<mixed> */
+    private function notes(OrderId $id): array
+    {
+        return self::getContainer()->get(Connection::class)
+            ->fetchFirstColumn('SELECT note FROM order_notes WHERE order_id = ? ORDER BY id', [$id->value]);
+    }
+}
