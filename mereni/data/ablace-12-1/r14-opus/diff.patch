diff --git a/tests/Acceptance/Legacy/CancelOrderTest.php b/tests/Acceptance/Legacy/CancelOrderTest.php
new file mode 100644
index 0000000..884d19f
--- /dev/null
+++ b/tests/Acceptance/Legacy/CancelOrderTest.php
@@ -0,0 +1,153 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Acceptance\Legacy;
+
+use App\Identity\Infrastructure\Security\DemoCustomerProvider;
+use App\Inventory\Domain\Repository\StockItemRepository;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\Repository\OrderRepository;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\OrderStatus;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use App\Tests\Support\Catalog;
+use App\Tests\Support\TestDatabase;
+use Doctrine\DBAL\Connection;
+use Doctrine\ORM\EntityManagerInterface;
+use PHPUnit\Framework\Attributes\Test;
+use Symfony\Bundle\FrameworkBundle\KernelBrowser;
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+/**
+ * Storno ve staré administraci: zaplacená částka se zaznamená k vrácení
+ * (peníze vrací obchod ručně) a zboží se vrátí na sklad.
+ */
+final class CancelOrderTest extends WebTestCase
+{
+    private KernelBrowser $client;
+
+    protected function setUp(): void
+    {
+        TestDatabase::reset();
+        // stará administrace drží spojení v globální proměnné
+        $GLOBALS['db'] = null;
+        $this->client = self::createClient();
+        $this->client->disableReboot();
+        Catalog::seed(self::getContainer()->get(Connection::class));
+    }
+
+    #[Test]
+    public function salesCancelsPaidOrderFromOrderDetail(): void
+    {
+        $this->loginAs('obchod@example.com');
+        // klávesnice 3 × 500 Kč, sleva 200 Kč: zaplaceno 1 300 Kč
+        $order = $this->paidOrder();
+
+        $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+        $this->client->submitForm('Stornovat', ['reason' => 'Zákazník si to rozmyslel']);
+
+        self::assertSelectorTextContains('.flash', 'Objednávka stornována');
+        self::assertSelectorTextContains('body', 'K vrácení zákazníkovi');
+        self::assertSelectorTextContains('body', '1 300,00');
+        $this->clearEntityManager();
+        $cancelled = self::getContainer()->get(OrderRepository::class)->get($order->id);
+        self::assertSame(OrderStatus::Cancelled, $cancelled->status);
+        self::assertSame('Zákazník si to rozmyslel', $cancelled->cancellationNote);
+        self::assertEquals(new Money(1300_00, Currency::CZK), $cancelled->refundDue());
+        self::assertSame(10, $this->available(Catalog::KEYBOARD));
+    }
+
+    #[Test]
+    public function shippedOrderCannotBeCancelled(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->paidOrder();
+        // token dřív, než se objednávka odešle: u odeslané už formulář storna není
+        $token = $this->csrfToken($order);
+        $order->ship();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        $this->postCancel($order, $token);
+
+        self::assertSelectorTextContains('.flash.error', 'Odeslanou ani doručenou objednávku');
+        $this->clearEntityManager();
+        self::assertSame(OrderStatus::Shipped, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+    }
+
+    #[Test]
+    public function cancelWithoutCsrfTokenChangesNothing(): void
+    {
+        $this->loginAs('obchod@example.com');
+        $order = $this->paidOrder();
+
+        $this->postCancel($order, 'neplatny-token');
+
+        self::assertResponseStatusCodeSame(403);
+        $this->clearEntityManager();
+        self::assertSame(OrderStatus::Paid, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+        self::assertSame(7, $this->available(Catalog::KEYBOARD));
+    }
+
+    #[Test]
+    public function warehouseCannotCancel(): void
+    {
+        $this->loginAs('sklad@example.com');
+        $order = $this->paidOrder();
+
+        $this->postCancel($order, $this->csrfToken($order));
+
+        self::assertResponseStatusCodeSame(403);
+        $this->clearEntityManager();
+        self::assertSame(OrderStatus::Paid, self::getContainer()->get(OrderRepository::class)->get($order->id)->status);
+    }
+
+    private function paidOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::fromString(Catalog::KEYBOARD), 3, new Money(500_00, Currency::CZK));
+        $order->applyDiscount(new Money(200_00, Currency::CZK));
+        $order->confirm();
+        $order->markPaid();
+        self::getContainer()->get(OrderRepository::class)->save($order);
+
+        return $order;
+    }
+
+    private function loginAs(string $email): void
+    {
+        $this->client->loginUser(
+            self::getContainer()->get(DemoCustomerProvider::class)->loadUserByIdentifier($email),
+        );
+    }
+
+    /** Token z formuláře storna v detailu objednávky. */
+    private function csrfToken(Order $order): string
+    {
+        $crawler = $this->client->request('GET', '/admin/legacy/order?id='.$order->id->value);
+
+        return (string) $crawler->filter('input[name="_csrf"]')->attr('value');
+    }
+
+    private function postCancel(Order $order, string $csrfToken): void
+    {
+        $this->client->request(
+            'POST',
+            '/admin/legacy/order_cancel?id='.$order->id->value,
+            ['reason' => '', '_csrf' => $csrfToken],
+        );
+    }
+
+    private function available(string $productId): int
+    {
+        return self::getContainer()->get(StockItemRepository::class)->get(ProductId::fromString($productId))->available();
+    }
+
+    private function clearEntityManager(): void
+    {
+        self::getContainer()->get(EntityManagerInterface::class)->clear();
+    }
+}
