+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Ordering\Domain;
+
+use App\Ordering\Domain\Exception\InvalidOrderStateTransitionException;
+use App\Ordering\Domain\Model\Order;
+use App\Ordering\Domain\ValueObject\CustomerId;
+use App\Ordering\Domain\ValueObject\OrderId;
+use App\Ordering\Domain\ValueObject\ProductId;
+use App\SharedKernel\Domain\Currency;
+use App\SharedKernel\Domain\Money;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Test;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Storno zaplacené objednávky zaznamená, kolik obchod vrátí zákazníkovi.
+ */
+#[CoversClass(Order::class)]
+final class OrderRefundTest extends TestCase
+{
+    #[Test]
+    public function newOrderHasNothingToRefund(): void
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate(), Currency::EUR);
+
+        self::assertTrue($order->refundDue->equals(Money::zero(Currency::EUR)));
+    }
+
+    #[Test]
+    public function cancelledPaidOrderRefundsPaidAmountAfterDiscount(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundDue->equals(new Money(500_00, Currency::CZK)));
+    }
+
+    #[Test]
+    public function cancelledUnpaidOrderRefundsNothing(): void
+    {
+        $order = $this->confirmedOrder();
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertTrue($order->refundDue->equals(Money::zero(Currency::CZK)));
+    }
+
+    #[Test]
+    public function secondCancelKeepsRefund(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        $order->cancel('customer request', new \DateTimeImmutable());
+
+        self::assertSame(500_00, $order->refundDue->amountInCents);
+    }
+
+    #[Test]
+    public function shippedOrderRefundsNothing(): void
+    {
+        $order = $this->confirmedOrder();
+        $order->markPaid();
+        $order->ship();
+
+        try {
+            $order->cancel('customer request', new \DateTimeImmutable());
+            self::fail('Expected InvalidOrderStateTransitionException');
+        } catch (InvalidOrderStateTransitionException) {
+        }
+
+        self::assertSame(0, $order->refundDue->amountInCents);
+    }
+
+    // klávesnice 2 × 300 Kč, sleva 100 Kč: zaplaceno 500 Kč
+    private function confirmedOrder(): Order
+    {
+        $order = Order::place(OrderId::generate(), CustomerId::generate());
+        $order->addItem(ProductId::generate(), 2, new Money(300_00, Currency::CZK));
+        $order->applyDiscount(new Money(100_00, Currency::CZK));
+        $order->confirm();
+
+        return $order;
+    }
+}
