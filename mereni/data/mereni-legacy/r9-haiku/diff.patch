+/**
+ * Uvolní rezervace objednávky ze skladu při stornování.
+ * Odebere objednávku z JSON pole reservations u všech stock_items.
+ */
+function release_order_reservations($orderId)
+{
+    global $db;
+    legacy_db();
+
+    $rows = $db->query("SELECT product_id, reservations FROM stock_items WHERE reservations IS NOT NULL AND reservations != ''");
+    foreach ($rows as $r) {
+        $data = json_decode((string) $r['reservations'], true);
+        if (!is_array($data) || !isset($data[$orderId])) {
+            continue;
+        }
+
+        unset($data[$orderId]);
+        $newReservations = empty($data) ? '' : json_encode($data);
+        $db->exec("UPDATE stock_items SET reservations = " . $db->quote($newReservations) . " WHERE product_id = '" . $r['product_id'] . "'");
+    }
+}
+
+/**
+ * Vrácení zaplacené částky za stornovanou objednávku.
+ * Zaloguje to do poznámky objednávky a do auditního logu.
+ */
+function process_order_refund($orderId, $amountInCents, $currency, $reason = 'Vrácení zaplacené částky')
+{
+    global $db;
+    legacy_db();
+
+    if ($amountInCents > 0) {
+        $amount = number_format($amountInCents / 100, 2, ',', '');
+        $refundNote = sprintf('REFUND: %s %s – %s', $amount, $currency, $reason);
+        $db->exec("INSERT INTO order_notes (order_id, author, note, created_at) VALUES ("
+            . $db->quote($orderId) . ", 'system', "
+            . $db->quote($refundNote) . ", '"
+            . date('Y-m-d H:i:s') . "')");
+
+        audit_log('order', $orderId, 'refund', array(
+            'amount_cents' => (int) $amountInCents,
+            'currency' => $currency,
+            'reason' => $reason,
+        ));
+    }
+}
