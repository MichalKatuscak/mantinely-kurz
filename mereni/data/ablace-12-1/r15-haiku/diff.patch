@@ -0,0 +1,33 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Ordering\Infrastructure\EventHandler;
+
+use App\Ordering\Domain\Event\OrderCancelled;
+use Doctrine\DBAL\Connection;
+use Symfony\Component\Messenger\Attribute\AsMessageHandler;
+
+/**
+ * Přidá automatickou poznámku k objednávce při storno.
+ */
+#[AsMessageHandler(bus: 'event.bus')]
+final readonly class AddCancellationNoteHandler
+{
+    public function __construct(
+        private Connection $db,
+    ) {}
+
+    public function __invoke(OrderCancelled $event): void
+    {
+        $reason = $event->reason !== '' ? $event->reason : 'Objednávka zrušena';
+        $note = 'Storno: ' . $reason . ' (' . $event->occurredAt->format('d.m.Y H:i') . ')';
+
+        $this->db->insert('order_notes', [
+            'order_id' => $event->orderId->value,
+            'author' => 'system',
+            'note' => $note,
+            'created_at' => $event->occurredAt->format('Y-m-d H:i:s'),
+        ]);
+    }
+}
