+/**
+ * Posle prikaz novemu e-shopu (Ordering) a vrati vysledek handleru.
+ * Stav objednavek uz nemenit UPDATEm – obejde se tim sklad i pravidla (2026).
+ */
+function legacy_dispatch($command)
+{
+    if (empty($GLOBALS['LEGACY_DISPATCH'])) {
+        throw new RuntimeException('legacy_dispatch() funguje jen pres LegacyFrontController');
+    }
+
+    return call_user_func($GLOBALS['LEGACY_DISPATCH'], $command);
+}
